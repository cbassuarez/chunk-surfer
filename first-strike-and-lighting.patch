+import test from 'node:test';import assert from 'node:assert/strict';
+import {FIRST_STRIKE as C,normalizeFirstStrikeEntry,firstStrikePieces,firstStrikePiecePose,firstStrikeFooting} from '../src/data/first-strike.js';
