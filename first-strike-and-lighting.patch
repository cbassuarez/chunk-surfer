index 0000000000000000000000000000000000000000..2f45b3b5801d1ac6874bf6c287eb740172c04926
--- /dev/null
+++ b/artifacts/first-strike-and-lighting/firststrike-rebuild-horn.py
@@ -0,0 +1,34 @@
+#!/usr/bin/env python3
+"""Rebuild the First Strike horn from the retained licensed source, offline.
+
+Example: python3 artifacts/first-strike-and-lighting/firststrike-rebuild-horn.py --output /tmp/clearance-horn.mp3
+This does not download media or replace a delivery asset unless that output is explicitly supplied.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--output', required=True, type=Path)
+args = parser.parse_args()
+root = Path(__file__).resolve().parents[2]
+source = root / 'assets/first-strike-audio-source/industrial-air-horn-hq.mp3'
+expected_source = 'a73670ddeee9bed590c19a928715a4ed866893992c849261d7acbc37e8966a9a'
+expected_delivery = '9094e7b74c16e9c9ea7a155a2f0207e8cad5cb2f5bf6d3935dcaeb32d0e37b8d'
+digest = lambda file: hashlib.sha256(file.read_bytes()).hexdigest()
+if digest(source) != expected_source:
+    raise SystemExit('Retained source identity differs; review provenance before rebuilding.')
+output = args.output.expanduser().resolve()
+if output == source:
+    raise SystemExit('The retained source cannot be overwritten.')
+subprocess.run([
+    'ffmpeg', '-v', 'error', '-y', '-i', str(source),
+    '-af', 'highpass=f=150,lowpass=f=5200,volume=-3dB,afade=t=in:st=0:d=0.008,afade=t=out:st=2.31:d=0.230',
+    '-ac', '1', '-ar', '48000', '-c:a', 'libmp3lame', '-b:a', '128k', str(output)
+], check=True)
+sha = digest(output)
+print(json.dumps({'output': str(output), 'sourceSha256': expected_source, 'sha256': sha,
+                  'matchesCurrentDelivery': sha == expected_delivery,
+                  'note': 'Byte identity verified with the installed FFmpeg/LAME build. Other encoder versions may differ; compare decoded PCM before replacing production media.'}, indent=2))
diff --git a/artifacts/first-strike-and-lighting/review-server.mjs b/artifacts/first-strike-and-lighting/review-server.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..5022bc3321d30452dec04e3be8dbbbf17084e3a9
--- /dev/null
+++ b/artifacts/first-strike-and-lighting/review-server.mjs
@@ -0,0 +1,35 @@
+// Local evidence sink only. No UI, profile, input or game-state automation.
+import {createServer} from 'vite';
+import {mkdir,readFile,writeFile} from 'node:fs/promises';
+import {resolve,dirname} from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {createHash} from 'node:crypto';
+const folder=dirname(fileURLToPath(import.meta.url)),root=resolve(folder,'../..'),port=Number(process.env.OPENING_REVIEW_PORT)||5410,revision=Date.now();
+const paths=["src/main.js", "src/dev/first-strike-review.js", "src/game/night-clock.js", "src/game/night-deadline.js", "src/game/first-strike-entry.js", "src/game/first-strike-scene.js", "src/data/first-strike.js", "src/render/first-strike-renderer.js", "src/render/r3d.js", "src/render/pixel-mesh/shader.js", "src/render/world-light-treatment.js", "src/render/props3d.js", "src/game/save.js", "src/game/playback.js", "src/progression/runtime.js", "src/progression/schema.js", "src/progression/report.js", "src/game/archive.js", "src/game/return-report.js", "src/render/outcome-return-view.js", "src/audio/first-strike.js", "src/audio/first-strike-warning.js","src/game/source-drive-session.js","src/game/source-drive/deadline.js","src/game/source-drive-renderer.js","public/audio/first-strike/clearance-horn.mp3","public/audio/first-strike/credits.json"];
+const reply=(res,status,value)=>{res.writeHead(status,{'Content-Type':'application/json','Cache-Control':'no-store'});res.end(JSON.stringify(value));};
+await mkdir(folder,{recursive:true});
+const server=await createServer({root,configFile:resolve(root,'vite.config.js'),cacheDir:'/private/tmp/chunk-surfer-fake-ellery-opening-vite',clearScreen:false,
+  server:{host:'127.0.0.1',port,strictPort:true,hmr:false,headers:{'Cache-Control':'no-store'},watch:{ignored:['**/artifacts/**','**/src-tauri/**']}},
+  plugins:[{name:'bounded-first-strike-capture',
+    transformIndexHtml:html=>html.replace(/(src=["'])(\/src\/main\.js[^"']*)(["'])/,(_all,a,url,b)=>`${a}${url}${url.includes('?')?'&':'?'}firstStrikeEvidenceRevision=${revision}${b}`),
+    configureServer(vite){vite.middlewares.use('/__first-strike',async(req,res)=>{
+      const name=(req.url||'').replace(/^\//,'').split('?')[0];
+      try{
+        if(req.method==='GET'&&name==='manifest'){
+          const files=await Promise.all(paths.map(async path=>{const bytes=await readFile(resolve(root,path));return{path,bytes:bytes.length,sha256:createHash('sha256').update(bytes).digest('hex')};}));
+          return reply(res,200,{serverRevision:revision,capturedAt:new Date().toISOString(),files});
+        }
+        if(req.method!=='POST'||!/^first-strike-\d{10,16}\.(webm|json|png)$/.test(name))return reply(res,400,{error:'Only named first-strike capture files are accepted.'});
+        const origin=req.headers.origin;
+        if(origin&&!['http://127.0.0.1:'+port,'http://localhost:'+port].includes(origin))return reply(res,403,{error:'Local capture origin required.'});
+        const chunks=[];let size=0;
+        for await(const chunk of req){size+=chunk.length;if(size>256*1024*1024)return reply(res,413,{error:'Capture exceeds 256 MiB.'});chunks.push(chunk);}
+        const bytes=Buffer.concat(chunks);if(name.endsWith('.json'))JSON.parse(bytes.toString('utf8'));
+        await writeFile(resolve(folder,name),bytes,{flag:'wx'});
+        return reply(res,200,{saved:name,bytes:size,sha256:createHash('sha256').update(bytes).digest('hex')});
+      }catch(error){return reply(res,error.code==='EEXIST'?409:500,{error:String(error.message||error)});}
+    });}
+  }]});
+await server.listen();
+console.log(JSON.stringify({ready:true,port,folder,revision,url:`http://127.0.0.1:${port}/?firstStrikeReview=1&nosd=1&nomic=1`}));
+const stop=async()=>{await server.close();process.exit(0);};process.on('SIGINT',stop);process.on('SIGTERM',stop);
