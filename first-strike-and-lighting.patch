+test('horn distance and head angle affect placement, not an unplaced stereo/synthetic stinger',()=>{const near=firstStrikeHornMix({x:3,y:2,z:-2},{x:0,y:1.62,z:0,yaw:0}),far=firstStrikeHornMix({x:50,y:2,z:-2},{x:0,y:1.62,z:0,yaw:0}),turned=firstStrikeHornMix({x:3,y:2,z:-2},{x:0,y:1.62,z:0,yaw:Math.PI});assert.ok(far.gain<near.gain);assert.ok(far.cutoff<near.cutoff);assert.ok(far.delay>near.delay);assert.ok(near.x*turned.x<0);});
+test('shipping cue and retained CC0 source have exact editable provenance, with the preview distinguished from a raw master',()=>{const source=JSON.parse(fs.readFileSync('assets/first-strike-audio-source/provenance.json')),credits=JSON.parse(fs.readFileSync('public/audio/first-strike/credits.json')),hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');assert.equal(source.sha256,hash('assets/first-strike-audio-source/industrial-air-horn-hq.mp3'));assert.equal(credits.sha256,hash('public/audio/first-strike/clearance-horn.mp3'));assert.equal(source.license,'CC0 1.0');assert.match(source.sourcePage,/freesound\.org\/people\/mcpable\/sounds\/131930/);assert.match(source.provenance,/preview, not the original/);assert.match(credits.processing,/No TTS/);assert.ok(credits.bytes<128000);});
