diff --git a/src/audio/first-strike-warning.js b/src/audio/first-strike-warning.js
new file mode 100644
index 0000000000000000000000000000000000000000..5a53f679e78e910f6a45665370fa03986902bc88
--- /dev/null
+++ b/src/audio/first-strike-warning.js
@@ -0,0 +1,18 @@
+// Real CC0 industrial oil-rig air horn by mcpable. The retained HQ preview and
+// its exact processing/provenance are shipped with the source and cue credits.
+import {assetUrl} from '../platform/paths.js';
+const finite=n=>typeof n==='number'&&Number.isFinite(n);
+const point=p=>p&&[p.x,p.y,p.z].every(finite)?p:null;
+export function firstStrikeHornMix(source,listener={}){const dx=source.x-(listener.x||0),dy=source.y-(listener.y||0),dz=source.z-(listener.z||0),yaw=listener.yaw||0,distance=Math.hypot(dx,dy,dz);return{x:dx*Math.cos(yaw)+dz*Math.sin(yaw),y:dy,z:-dx*Math.sin(yaw)+dz*Math.cos(yaw),gain:(1+distance/32)**-.75,cutoff:Math.max(900,6000/(1+distance/70)),delay:Math.min(.28,distance/343)};}
+export function createFirstStrikeWarningAudio({getAudio=()=>null,fetcher=globalThis.fetch,urlFor=file=>assetUrl('audio/first-strike/'+file)}={}){
+ let graph=null,disposed=false,seen=new Set(),history=[],lastListener={},protectedAudio=false;
+ function muted(p={}){return!!(p.protected||p.paused||p.hidden||p.suspended||p.focused===false||p.foreground===false);}
+ function stop(){if(!graph)return;graph.master.gain.cancelScheduledValues?.(graph.ctx.currentTime);graph.master.gain.value=0;for(const v of graph.voices){try{v.source.stop();}catch{}for(const n of v.nodes)n.disconnect?.();}graph.voices.clear();}
+ function ensure(){if(disposed)return null;const pair=getAudio(),ctx=pair?.ctx||pair?.context,destination=pair?.destination;if(!ctx||!destination)return null;if(graph?.ctx===ctx&&graph.destination===destination)return graph;if(graph){stop();graph.master.disconnect?.();}const master=ctx.createGain();master.gain.value=.32;master.connect(destination);graph={ctx,destination,master,buffer:null,loading:null,error:null,voices:new Set()};return graph;}
+ async function ready(){const g=ensure();if(!g)return false;if(g.buffer)return true;if(g.loading)return g.loading;g.loading=(async()=>{const response=await fetcher(urlFor('clearance-horn.mp3'));if(!response.ok)throw Error('Clearance horn could not load.');const bytes=await response.arrayBuffer();if(bytes.byteLength<1000||bytes.byteLength>128000)throw Error('Clearance horn byte budget exceeded.');const b=await g.ctx.decodeAudioData(bytes);if(b.numberOfChannels!==1||b.duration<2.3||b.duration>2.9)throw Error('Clearance horn source format mismatch.');if(disposed||graph!==g)return false;g.buffer=b;return true;})().catch(e=>{g.error=String(e?.message||e);return false;});return g.loading;}
+ function update(p={}){lastListener=p.listener||lastListener;protectedAudio=muted(p);if(protectedAudio){stop();return;}if(!graph)return;graph.master.gain.value=.32;for(const v of[...graph.voices]){if(graph.ctx.currentTime>=v.until){graph.voices.delete(v);continue;}const m=firstStrikeHornMix(v.position,lastListener);v.level.gain.value=m.gain;v.filter.frequency.value=m.cutoff;if(v.panner.positionX){v.panner.positionX.value=m.x;v.panner.positionY.value=m.y;v.panner.positionZ.value=m.z;}else v.panner.setPosition?.(m.x,m.y,m.z);}}
+ function warn(event={},p={}){const id=String(event.id||event.eventId||'');if(!id||seen.has(id)||disposed)return false;seen.add(id);if(seen.size>64)seen.delete(seen.values().next().value);const position=point(event.position),g=ensure();let reason=muted(p)?'protected-no-replay':event.age>.16?'stale-no-replay':!position?'no-physical-origin':!g?.buffer?'not-ready-no-backlog':g.ctx.state&&g.ctx.state!=='running'?'audio-context-not-running':g.voices.size>=2?'voice-budget':null;history.push({id,position,reason:reason||'played'});if(history.length>64)history.shift();if(reason){if(muted(p))stop();return false;}
+  lastListener=p.listener||lastListener;const m=firstStrikeHornMix(position,lastListener),source=g.ctx.createBufferSource(),panner=g.ctx.createPanner(),filter=g.ctx.createBiquadFilter(),level=g.ctx.createGain();source.buffer=g.buffer;panner.panningModel='HRTF';panner.distanceModel='inverse';panner.rolloffFactor=0;panner.refDistance=1;filter.type='lowpass';filter.frequency.value=m.cutoff;level.gain.value=m.gain;source.connect(filter).connect(level).connect(panner).connect(g.master);const voice={source,panner,filter,level,position:{...position},until:g.ctx.currentTime+m.delay+g.buffer.duration,nodes:[source,filter,level,panner]};g.voices.add(voice);g.master.gain.value=.32;update(p);source.start(g.ctx.currentTime+m.delay);source.onended=()=>{g.voices.delete(voice);for(const n of voice.nodes)n.disconnect?.();};return true;
+ }
+ return{ready,warn,update,stop,snapshot:()=>({ready:!!graph?.buffer,error:graph?.error||null,voices:graph?.voices.size||0,protected:protectedAudio,receipts:[...seen],history:[...history],source:'Industrial Air Horn / mcpable / CC0 1.0 / licensed HQ preview',measuredRoomResponse:false}),dispose(){stop();disposed=true;graph?.master.disconnect?.();graph=null;}};
+}
diff --git a/src/audio/first-strike.js b/src/audio/first-strike.js
new file mode 100644
index 0000000000000000000000000000000000000000..a6fa6fa2d10659e3a09cab48375c1a23cf4298ce
--- /dev/null
+++ b/src/audio/first-strike.js
@@ -0,0 +1,20 @@
+// Existing credited CC0 physical material only. The source documentary panel
+// recording and authored short reflections are not measured room responses or
+// a newly recorded full-building demolition. The separate warning player uses
+// a retained CC0 real industrial horn, not TTS or a synthesized siren.
+import {createFirstStrikeWarningAudio} from './first-strike-warning.js';
+import {createSourceDemolitionAudio} from './source-demolition.js';
+import {SOURCE_DEMOLITION_AUDIO_SOURCES} from '../data/source-demolition-audio.js';
+export const FIRST_STRIKE_AUDIO_PROVENANCE=Object.freeze({sources:SOURCE_DEMOLITION_AUDIO_SOURCES,processing:'Existing source-demolition bank, normal SFX bus, fixed-world HRTF/distance/low-pass and explicitly authored reflection taps.',horn:{title:'Industrial Air Horn',author:'mcpable',license:'CC0 1.0',url:'https://freesound.org/people/mcpable/sounds/131930/',source:'Retained licensed HQ MP3 preview; original WAV not held'},limitations:'No new documentary full-building fracture recording; visible construction remains complete when audio is unavailable.'});
+export function createFirstStrikeAudio(options={}){
+ const material=options.material||createSourceDemolitionAudio(options);let muted=true,history=[],lastBodyAt=-Infinity;const horn=options.horn||createFirstStrikeWarningAudio(options);
+ return{ready:()=>Promise.all([material.ready?.(),horn.ready?.()]).then(r=>r.some(Boolean)),prepareWarnings:()=>horn.ready?.(),warning:(event,p)=>horn.warn?.(event,p),updateWarnings:p=>horn.update?.(p),update(frame={},presentation={}){
+  const protectedAudio=!!(presentation.protected||presentation.paused||presentation.suspended||presentation.hidden||presentation.focused===false||presentation.foreground===false),events=[];
+  for(const event of frame.events||[]){let type=event.type==='strain'?'strain':event.type==='first-strike'?'release':event.type==='joint-hang'?'course':event.type==='course-release'?'release':event.type==='final-settlement'?'course':event.type==='terminal'?'consumed':null;if(!type)continue;if(type==='release'){if(frame.elapsed-lastBodyAt<5.5)type='course';else lastBodyAt=frame.elapsed;}
+   // Release events remain individually anchored; the original voice budget
+   // rejects excess material instead of creating a louder synthetic monster.
+   const mapped={...event,type,gain:event.type==='course-release'?.52:.70};events.push(mapped);history.push({id:event.id,semantic:event.type,type,protected:protectedAudio});
+  }horn.update?.(presentation);if(history.length>128)history=history.slice(-128);muted=protectedAudio;
+  return material.update({...frame,active:frame.active!==false,clock:frame.elapsed,blackness:frame.darkness,events},{...presentation,protected:protectedAudio,suspended:!!presentation.suspended,listener:presentation.listener});
+ },stop(){muted=true;material.stop?.();horn.stop?.();},snapshot:()=>({...material.snapshot?.(),firstStrike:true,muted,horn:horn.snapshot?.(),history:[...history],provenance:FIRST_STRIKE_AUDIO_PROVENANCE}),destroy(){material.destroy?.();horn.dispose?.();},dispose(){material.destroy?.();horn.dispose?.();}};
