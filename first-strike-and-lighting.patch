+test('real clearance horn is loaded within a bounded byte/channel/duration budget, world anchored and emitted only once',async()=>{const h=audioContext(),a=createFirstStrikeWarningAudio({getAudio:()=>h,fetcher:async()=>({ok:true,arrayBuffer:async()=>new ArrayBuffer(42000)})});assert.equal(await a.ready(),true);const e={id:'warning:0550',position:{x:30,y:3,z:-5},age:0};assert.equal(a.warn(e,{listener:{x:0,y:1.62,z:0,yaw:0}}),true);assert.equal(h.starts.length,1);assert.ok(h.starts[0]>0&&h.starts[0]<=.28);assert.equal(a.warn(e,{}),false);assert.equal(h.starts.length,1);a.update({protected:true});assert.equal(h.stops(),1);assert.equal(a.snapshot().voices,0);a.update({listener:{x:5,y:1.62,z:0,yaw:1}});assert.equal(h.starts.length,1,'pause cannot replay a recorded horn');a.dispose();});
