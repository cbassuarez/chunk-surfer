{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "personalized-interference",
  "description": "Restricts opted-in choreography to four fixed fireball surfaces and eight fixed game-owned media surfaces; no external applications, arbitrary web content, or player files are permitted.",
  "windows": [
    "main",
    "fireball-cast-1",
    "fireball-cast-2",
    "fireball-cast-3",
    "fireball-cast-4"
    ,"window-media-1"
    ,"window-media-2"
    ,"window-media-3"
    ,"window-media-4"
    ,"window-media-5"
    ,"window-media-6"
    ,"window-media-7"
    ,"window-media-8"
  ],
  "permissions": [
    "core:event:allow-emit",
    "core:event:allow-emit-to",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-get-all-webviews",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-set-focus"
    ,"core:window:allow-start-dragging"
  ]
}
