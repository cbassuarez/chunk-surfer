{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chunk Surfer",
  "version": "0.1.0",
  "identifier": "com.cbassuarez.chunksurfer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chunk Surfer",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi",
      "appimage",
      "deb"
    ],
    "category": "Game",
    "shortDescription": "A haunting at Ellery Conservatory.",
    "longDescription": "Chunk Surfer is a web-native horror game built around room tone, recording, and physical text systems.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
