+    (function () {
+      var root = document.documentElement;
+      var sheet = document.getElementById('mainStyles');
+      var marked = false;
+      function markStylesReady() {
+        if (marked) return;
+        marked = true;
+        root.classList.remove('cs-awaiting-styles');
+        root.classList.add('cs-styles-ready');
+      }
+      if (!sheet) {
+        markStylesReady();
+        return;
+      }
+      sheet.addEventListener('load', markStylesReady, { once: true });
+      sheet.addEventListener('error', function () {
+        root.classList.add('cs-style-error');
+        markStylesReady();
+      }, { once: true });
+      try {
+        if (sheet.sheet) markStylesReady();
+      } catch (_) {}
+      window.setTimeout(function () {
+        if (!marked) root.classList.add('cs-style-waiting');
+      }, 600);
+      window.setTimeout(markStylesReady, 4000);
+    }());
