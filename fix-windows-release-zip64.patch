+          $releaseRoot = "release/windows"
+          $zipName = "chunk-surfer-v$version-windows-x64.zip"
+          $zip = Join-Path $releaseRoot $zipName
+
+          $sevenZipCandidates = @((Get-Command 7z -ErrorAction SilentlyContinue).Source)
+          if ($env:ProgramFiles) {
+            $sevenZipCandidates += Join-Path $env:ProgramFiles "7-Zip/7z.exe"
+          }
+          $programFilesX86 = [Environment]::GetEnvironmentVariable('ProgramFiles(x86)')
+          if ($programFilesX86) {
+            $sevenZipCandidates += Join-Path $programFilesX86 "7-Zip/7z.exe"
+          }
+          $sevenZip = $sevenZipCandidates | Where-Object { $_ -and (Test-Path $_) } | Select-Object -First 1
+          if (-not $sevenZip) {
+            throw "7-Zip is required to package the oversized Windows portable zip"
+          }
+
+          Remove-Item $zip -Force -ErrorAction SilentlyContinue
+          Push-Location $releaseRoot
+          try {
+            & $sevenZip a -tzip -mx=1 $zipName "Chunk Surfer"
+            if ($LASTEXITCODE -ne 0) {
+              throw "7-Zip archive creation failed with exit code $LASTEXITCODE"
+            }
+
+            & $sevenZip t $zipName
+            if ($LASTEXITCODE -ne 0) {
+              throw "7-Zip archive verification failed with exit code $LASTEXITCODE"
+            }
+          } finally {
+            Pop-Location
+          }
+
           $verifyRoot = "release/windows-verify"
           Remove-Item $verifyRoot -Recurse -Force -ErrorAction SilentlyContinue
-          Expand-Archive -Path $zip -DestinationPath $verifyRoot -Force
+          New-Item -ItemType Directory -Force -Path $verifyRoot | Out-Null
+          & $sevenZip x $zip "-o$verifyRoot" -y
+          if ($LASTEXITCODE -ne 0) {
+            throw "7-Zip archive extraction failed with exit code $LASTEXITCODE"
+          }
+
           node scripts/validate-windows-portable.mjs "$verifyRoot/Chunk Surfer"
 
