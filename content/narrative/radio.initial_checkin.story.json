      "id": "start",
      "type": "choice",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / front desk relay",
        "status": "LIVE"
      },
      "lines": [
        {
          "id": "checkin.onset",
          "who": "radio",
          "text": "4417-C? Martin, front desk. Are you inside all right?"
        },
        {
          "id": "checkin.latch",
          "who": "direction",
          "text": "A small contact clicks under your thumb, just before you press transmit."
        }
      ],
      "choices": [
        {
          "id": "start.choice.1",
          "text": "I'm in. Basement first.",
          "goto": "identify"
        },
        {
          "id": "start.choice.2",
          "text": "Five room tones, a minute each?",
          "goto": "work"
        },
        {
          "id": "start.choice.3",
          "text": "You'll be on this channel?",
          "goto": "channel"
        }
      ]
    },
    "identify": {
      "id": "identify",
      "type": "dialogue",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / front desk relay",
        "status": "LIVE"
      },
      "lines": [
        {
          "id": "identify.line.1",
          "who": "me",
          "text": "I'm in. Basement first."
        },
        {
          "id": "identify.line.2",
          "who": "radio",
          "text": "Good. {SETUPROUTE}"
        },
        {
          "id": "identify.line.3",
          "who": "radio",
          "text": "I've got you down as arrived."
        }
      ],
      "goto": "after"
    },
    "work": {
      "id": "work",
      "type": "dialogue",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / front desk relay",
        "status": "LIVE"
      },
      "lines": [
        {
          "id": "work.line.1",
          "who": "me",
          "text": "Five room tones, a minute each?"
        },
        {
          "id": "work.line.2",
          "who": "radio",
          "text": "That's the order. B3 first. Get the case settled before you roll, and leave yourself a note when each one's done."
        },
        {
          "id": "work.line.3",
          "who": "radio",
          "text": "If a room number's been painted over, call me. The old plan still has them."
        }
      ],
      "goto": "after"
    },
    "channel": {
      "id": "channel",
      "type": "dialogue",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / front desk relay",
        "status": "LIVE"
      },
      "lines": [
        {
          "id": "channel.line.1",
          "who": "me",
          "text": "You'll be on this channel?"
        },
        {
          "id": "channel.line.2",
          "who": "radio",
          "text": "Channel two. I'm here till the morning man comes in."
        },
        {
          "id": "channel.line.3",
          "who": "radio",
          "text": "Say which landing you're on and I'll find you. No need to guess your way down."
        }
      ],
      "goto": "after"
    },
    "after": {
      "id": "after",
      "type": "dialogue",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / carrier quiet",
        "status": "LIVE"
      },
      "lines": [
        {
          "id": "checkin.after",
          "who": "direction",
          "text": "A pencil taps the desk twice. Martin puts down the handset; the channel closes."
