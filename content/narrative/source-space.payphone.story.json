        },
        {
          "id": "emergency.say-nothing",
          "text": "(say nothing)",
          "goto": "emergency-silence"
        },
        {
          "id": "emergency.slate",
          "text": "\"Room, take number, date —\"",
          "goto": "emergency-slate"
        }
      ]
    },
    "emergency-speech": {
      "id": "emergency-speech",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "emergency-speech.cannot",
          "who": "operator",
          "text": "Caller, I can't make out what you're saying."
        },
        {
          "id": "emergency-speech.where",
          "who": "operator",
          "text": "Can you tell me where you are?"
        },
        {
          "id": "emergency-speech.no",
          "who": "you",
          "text": "No."
        },
        {
          "id": "emergency-speech.end",
          "who": "direction",
          "text": "[She waits. The line holds at the level of an empty room. Then it clears.]",
          "cue": "phone:-:far-clear"
        }
      ]
    },
    "emergency-silence": {
      "id": "emergency-silence",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "emergency-silence.where",
          "who": "operator",
          "text": "Caller, can you tell me where you are?"
        },
        {
          "id": "emergency-silence.cannot",
          "who": "you",
          "text": "No."
        },
        {
          "id": "emergency-silence.end",
          "who": "direction",
          "text": "[The line holds at the level of an empty room. Then it clears.]",
          "cue": "phone:-:far-clear"
        }
      ]
    },
    "emergency-slate": {
      "id": "emergency-slate",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "emergency-slate.again",
          "who": "operator",
          "text": "Caller? Which service do you need?"
        },
        {
          "id": "emergency-slate.habit",
          "who": "you",
          "text": "Sorry. Habit."
        },
        {
          "id": "emergency-slate.end",
          "who": "direction",
          "text": "You put it down before she has to ask a third time."
        }
      ]
    },
    "operator": {
      "id": "operator",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "listen": {
        "speech": "operator-pardon",
        "seconds": 6
      },
      "lines": [
        {
          "id": "operator.require",
          "who": "operator",
          "text": "Operator. What number do you require?",
          "cue": "phone:answer:operator-room"
        }
      ],
      "choices": [
        {
          "id": "operator.spoke",
          "text": "(speak into it)",
          "goto": "operator-pardon",
          "when": "phone.mic.live"
        },
        {
          "id": "operator.sarah",
          "text": "\"A number for Sarah. I can give you the surname.\"",
          "goto": "operator-sarah"
        },
        {
          "id": "operator.nothing",
          "text": "\"Nothing. Wrong number.\"",
          "goto": "operator-end"
        }
      ]
    },
    "operator-pardon": {
      "id": "operator-pardon",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "operator-pardon.sorry",
          "who": "operator",
          "text": "Sorry, caller, you're very faint. What number?"
        }
      ],
      "choices": [
        {
          "id": "operator-pardon.sarah",
          "text": "\"A number for Sarah. I can give you the surname.\"",
          "goto": "operator-sarah"
        },
        {
          "id": "operator-pardon.nothing",
          "text": "\"Nothing. Wrong number.\"",
          "goto": "operator-end"
        }
      ]
    },
    "operator-sarah": {
      "id": "operator-sarah",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "operator-sarah.ex",
          "who": "operator",
          "text": "I'm sorry, caller. That number is ex-directory. I can't give it out."
        },
        {
          "id": "operator-sarah.me",
          "who": "you",
          "text": "Even to me."
        },
        {
          "id": "operator-sarah.even",
          "who": "operator",
          "text": "Especially not, caller."
        }
      ]
    },
    "operator-end": {
      "id": "operator-end",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "operator-end.thanks",
          "who": "operator",
          "text": "Thank you for calling."
        },
        {
          "id": "operator-end.clear",
          "who": "direction",
          "text": "[The line clears.]",
          "cue": "phone:-:far-clear"
        }
      ]
    },
    "enquiries": {
      "id": "enquiries",
      "type": "dialogue",
      "speaker": "DIRECTORY ENQUIRIES",
      "lines": [
        {
          "id": "enquiries.1",
          "who": "direction",
          "text": "[Answered on the second ring.]",
          "cue": "phone:answer:enquiries-room"
        },
        {
          "id": "enquiries.2",
          "who": "enquiries",
          "text": "Directory enquiries. Which town, please?"
        }
      ],
      "choices": [
        {
          "id": "phone.enquiries.sarah",
          "text": "\"Ashworth. Sarah Ashworth.\"",
          "goto": "enquiries-sarah"
        },
        {
          "id": "phone.enquiries.sister",
          "text": "\"Ashworth, J. Carr Lane.\"",
          "goto": "enquiries-sister"
        },
        {
          "id": "phone.enquiries.lyle",
          "text": "\"Lyle. Leeds. I never knew his surname.\"",
          "goto": "enquiries-lyle"
        },
        {
          "id": "phone.enquiries.sorry",
          "text": "\"Sorry. Nothing.\"",
          "goto": "enquiries-end"
        }
      ]
    },
    "enquiries-sarah": {
      "id": "enquiries-sarah",
      "type": "dialogue",
      "speaker": "DIRECTORY ENQUIRIES",
      "lines": [
        {
          "id": "enquiries-sarah.1",
          "who": "enquiries",
          "text": "I'm sorry, caller. That number is ex-directory."
        },
        {
          "id": "enquiries-sarah.2",
          "who": "you",
          "text": "Even to me."
        },
        {
          "id": "enquiries-sarah.3",
          "who": "enquiries",
          "text": "I don't know who you are, caller."
        }
      ]
    },
    "enquiries-sister": {
      "id": "enquiries-sister",
      "type": "dialogue",
      "speaker": "DIRECTORY ENQUIRIES",
      "lines": [
        {
          "id": "enquiries-sister.1",
          "who": "enquiries",
          "text": "The number is oh six three two, nine six oh, five five two."
        },
        {
          "id": "enquiries-sister.2",
          "who": "you",
          "text": "Her sister. She won't pick up for me."
        }
      ]
    },
    "enquiries-lyle": {
      "id": "enquiries-lyle",
      "type": "dialogue",
      "speaker": "DIRECTORY ENQUIRIES",
      "lines": [
        {
          "id": "enquiries-lyle.1",
          "who": "enquiries",
          "text": "I'd need a surname, caller."
        },
        {
          "id": "enquiries-lyle.2",
          "who": "you",
          "text": "So would I."
        }
      ]
    },
    "enquiries-end": {
      "id": "enquiries-end",
      "type": "dialogue",
      "speaker": "DIRECTORY ENQUIRIES",
      "lines": [
        {
          "id": "enquiries-end.1",
          "who": "enquiries",
          "text": "Thank you for calling."
        }
      ]
    },
    "loop-answer": {
      "id": "loop-answer",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "loop-answer.1",
          "who": "direction",
          "text": "[Lifted. The van's cab: rain on a windscreen, the dash light, a handset lying on a seat.]",
          "cue": "phone:answer:van-cab"
        },
        {
          "id": "loop-answer.2",
          "who": "caller",
          "text": "There you are."
        },
        {
          "id": "loop-answer.3",
          "who": "direction",
          "text": "[Put down. The van's handset stays where it is, on the seat.]",
          "cue": "phone:hang:far-clear"
        }
      ]
    },
    "loop": {
      "id": "loop",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "loop.1",
          "who": "direction",
          "text": "[Lifted. The van's cab: rain on a windscreen, the dash light, a handset lying on a seat.]",
          "cue": "phone:answer:van-cab"
        },
        {
          "id": "loop.2",
          "who": "direction",
          "text": "[And someone else on the line with it. Not breathing. Waiting.]"
        }
      ],
      "listen": {
        "speech": "loop-spoken",
        "silence": "loop-silent",
        "seconds": 8
      },
      "choices": [
        {
          "id": "phone.loop.speak",
          "text": "(speak into it)",
          "goto": "loop-spoken",
          "when": "phone.mic.live",
          "mutations": {
            "set": [
              "phone.loop.broken"
            ]
          }
        },
        {
          "id": "phone.loop.hello",
          "text": "\"Hello?\"",
          "goto": "loop-spoken",
          "mutations": {
            "set": [
              "phone.loop.broken"
            ]
          }
        },
        {
          "id": "phone.loop.who",
          "text": "\"Who is this?\"",
          "goto": "loop-spoken",
          "mutations": {
            "set": [
              "phone.loop.broken"
            ]
          }
        },
        {
          "id": "phone.loop.nothing",
          "text": "(say nothing)",
          "goto": "loop-silent"
        }
      ]
    },
    "loop-spoken": {
      "id": "loop-spoken",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "loop-spoken.1",
          "who": "direction",
          "text": "[A moment later, across the road, your voice comes out of the van, small.]"
        },
        {
          "id": "loop-spoken.2",
          "who": "caller",
          "text": "There you are."
        },
        {
          "id": "loop-spoken.3",
          "who": "direction",
          "text": "[Put down. The van's handset stays where it is, on the seat.]",
          "cue": "phone:hang:far-clear"
        }
      ],
      "mutations": {
        "set": [
          "phone.loop.broken"
        ]
      }
    },
    "loop-silent": {
      "id": "loop-silent",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "loop-silent.1",
          "who": "direction",
          "text": "[Nobody says anything. The rain on the windscreen.]"
        },
        {
          "id": "loop-silent.2",
          "who": "direction",
          "text": "[Then the line clears, and the dial tone comes back as if nobody had rung. Outside, the road is the same road again.]",
          "cue": "phone:hang:far-clear"
        }
      ]
    },
    "self-line": {
      "id": "self-line",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "self-line.1",
          "who": "direction",
          "text": "[Already on the line when you lift it: this box, heard from underneath. The rain on its glass comes up through something thick and wet, a beat late, and under it, breathing.]",
          "cue": "phone:answer:self-underwater"
        }
      ]
    },
    "self-line-mic": {
      "id": "self-line-mic",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "self-line-mic.1",
          "who": "direction",
          "text": "[Already on the line. When you speak it comes back from under the road, slow and smeared, a beat late, and then again, further down.]",
          "cue": "phone:answer:self-voice"
        }
      ]
    },
    "pips-first": {
      "id": "pips-first",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "pips-first.1",
          "who": "direction",
          "text": "[Rapid pips. The lamp by the slot lights.]"
        },
        {
          "id": "pips-first.2",
          "who": "you",
          "text": "Pay on answer. They've picked up. All they can hear is the pips."
        }
      ]
    },
    "tape-first": {
      "id": "tape-first",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "tape-first.1",
          "who": "direction",
          "text": "[It goes in. It should not fit, and it goes in, and something inside the box takes hold of it and starts to pull.]"
        },
        {
          "id": "tape-first.2",
          "who": "you",
          "text": "It's recording. Over my rooms."
        }
      ]
    },
    "look-card": {
      "id": "look-card",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "look-card.1",
          "who": "direction",
          "text": "[The card in the middle of the dial, under yellowed celluloid: 999, 100, directory enquiries 192, the speaking clock 123, and this payphone's own number, 0632 960901.]"
        }
      ]
    },
    "look-instructions": {
      "id": "look-instructions",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "look-instructions.1",
          "who": "direction",
          "text": "[LIFT HANDSET. LISTEN FOR DIAL TONE. DIAL NUMBER. WHEN YOU HEAR RAPID PIPS, INSERT MONEY.]"
        },
        {
          "id": "look-instructions.2",
          "who": "you",
          "text": "Pay on answer. I haven't seen one of these in years."
        }
      ]
    },
    "look-scratches": {
      "id": "look-scratches",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "look-scratches.1",
          "who": "direction",
          "text": "[Numbers worked into the margin of the phone book. KAREN. TAXIS. D, in Leeds, the last two digits gone.]"
        },
        {
          "id": "look-scratches.2",
          "who": "direction",
          "text": "[CAR 0836 9_0 4_7. LODGE 0632 96_ 214, SEE CARD. And under them, pressed hard through the paper: DON'T RING HER.]"
        },
        {
          "id": "look-scratches.3",
          "who": "you",
          "text": "The car one's mine. Half of it. The rest is on the dash."
        }
      ]
    },
    "look-directory": {
      "id": "look-directory",
      "type": "dialogue",
      "speaker": "THE PHONE BOOK",
      "lines": [
        {
          "id": "look-directory.1",
          "who": "direction",
          "text": "[The phone book on its chain, open at A. Ashworth J., Carr Lane, 0632 960552. Ashworth R.M., Mill Row.]"
        },
        {
          "id": "look-directory.2",
          "who": "direction",
          "text": "[The page that comes after is gone. Torn out close to the spine, recently.]"
        },
        {
          "id": "look-directory.3",
          "who": "you",
          "text": "Somebody wanted her more than I did. Or not somebody."
        }
      ]
    },
    "look-window": {
      "id": "look-window",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "look-window.1",
          "who": "direction",
          "text": "[A little glass window in the coinbox. Behind it, when the tape is in, its spools, turning, and the name of whatever room is going under the head.]"
        }
      ]
    },
    "lyle-recall": {
      "id": "lyle-recall",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "lyle-recall.1",
          "who": "you",
          "text": "Oh five three two, nine six oh, two eight three. His hall. I still know it. Of course I still know it."
        }
      ]
    },
    "van-hanging": {
      "id": "van-hanging",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "van-hanging.1",
          "who": "direction",
          "text": "[You leave the handset hanging off its hook. Up the road, the van goes on ringing.]"
        }
      ]
    },
    "unpaid": {
      "id": "unpaid",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "unpaid.1",
          "who": "direction",
          "text": "[They listen to the pips as long as anyone would. Then the line clears.]"
        }
      ]
    },
    "tape-lost": {
      "id": "tape-lost",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "tape-lost.1",
          "who": "you",
          "text": "That was a room. It's a phone call now."
        }
      ]
    },
    "flurry": {
      "id": "flurry",
      "type": "dialogue",
      "speaker": "HER PAGE",
      "lines": [
        {
          "id": "flurry.1",
          "who": "direction",
          "text": "TXT 23:41 — are you coming or not. S"
        },
        {
          "id": "flurry.2",
          "who": "direction",
          "text": "TXT 23:58 — you said nine."
        },
        {
          "id": "flurry.3",
          "who": "direction",
          "text": "ANSWERPHONE, typed out — \"It's me. It's gone midnight. I'm going to bed. Don't bother.\""
        },
        {
          "id": "flurry.4",
          "who": "direction",
          "text": "TXT 02:10 — sorry. session ran over. tomorrow? — you"
        },
        {
          "id": "flurry.5",
          "who": "direction",
          "text": "TXT 02:11 — there's always a tomorrow with you."
        },
        {
          "id": "flurry.6",
          "who": "direction",
          "text": "CARD, torn in half — Happy birth— / —love from both of us"
        },
        {
          "id": "flurry.7",
          "who": "direction",
          "text": "LETTER — I'm not angry any more. That's the part that should frighten you. S."
        },
        {
          "id": "flurry.8",
          "who": "direction",
          "text": "you, to S — I'll make it up to you. next week. properly."
        },
        {
          "id": "flurry.9",
          "who": "direction",
          "text": "0632 960331 — I waited by it all that week."
        },
        {
          "id": "flurry.10",
          "who": "direction",
          "text": "S. — Don't ring here again."
        }
      ]
    },
    "flurry.lyle": {
      "id": "flurry.lyle",
      "type": "dialogue",
      "speaker": "HER PAGE",
      "lines": [
        {
          "id": "flurry.lyle.1",
          "who": "direction",
          "text": "HALL PAYPHONE, message pad — LYLE: your boyfriend rang. again. no name."
        },
        {
          "id": "flurry.lyle.2",
          "who": "direction",
          "text": "LETTER, Leeds — You love the idea of me more than you love me. L."
        },
        {
          "id": "flurry.lyle.3",
          "who": "direction",
          "text": "POSTCARD — I came to the gig. You never looked up from the desk. L."
        },
        {
          "id": "flurry.lyle.4",
          "who": "direction",
          "text": "you, to L, never posted — I'll come up at Christmas. Properly this time."
        },
        {
          "id": "flurry.lyle.5",
          "who": "direction",
          "text": "L. — Don't come up at Christmas."
        },
        {
          "id": "flurry.lyle.6",
          "who": "direction",
          "text": "you — we'll do it properly next year."
        },
        {
          "id": "flurry.lyle.7",
          "who": "direction",
          "text": "L. — It was never the distance."
        }
      ]
    },
    "flurry.them": {
      "id": "flurry.them",
      "type": "dialogue",
      "speaker": "HER PAGE",
      "lines": [
        {
          "id": "flurry.them.1",
          "who": "direction",
          "text": "GUARD'S FORM — VISITOR IN 20:14. OUT: —. KNOWN TO STAFF: NO."
        },
        {
          "id": "flurry.them.2",
          "who": "direction",
          "text": "OFFICE, on the letterhead — We will not be requiring your services again."
        },
        {
          "id": "flurry.them.3",
          "who": "direction",
          "text": "THE STUDENT AT LYLE'S HALL — some bloke keeps ringing for him. he left in the spring."
        },
        {
          "id": "flurry.them.4",
          "who": "direction",
          "text": "THE MAN AT SARAH'S — Leave her be. You had your go."
        },
        {
          "id": "flurry.them.5",
          "who": "direction",
          "text": "DIRECTORY ENQUIRIES — I'm sorry, caller. There's no listing for you either."
        },
        {
          "id": "flurry.them.6",
          "who": "direction",
          "text": "HER SISTER — She cried for a month, and then she stopped, and you couldn't stand that."
        },
        {
          "id": "flurry.them.7",
          "who": "direction",
          "text": "YOUR ANSWERPHONE — \"You've got me. I'm not in.\" You never were."
        }
      ]
    },
    "flurry.him": {
      "id": "flurry.him",
      "type": "dialogue",
      "speaker": "HER PAGE",
      "lines": [
        {
          "id": "flurry.him.1",
          "who": "direction",
          "text": "TAKE 1 — no good. go again."
        },
        {
          "id": "flurry.him.2",
          "who": "direction",
          "text": "TAKE 2 — no good. go again."
        },
        {
          "id": "flurry.him.3",
          "who": "direction",
          "text": "you, to S — next time. I promise. next time."
        },
        {
          "id": "flurry.him.4",
          "who": "direction",
          "text": "you, to L — there'll be another chance."
        },
        {
          "id": "flurry.him.5",
          "who": "direction",
          "text": "TAKE 9 — no good. go again."
        },
        {
          "id": "flurry.him.6",
          "who": "direction",
          "text": "you — there's always another take."
        },
        {
          "id": "flurry.him.7",
          "who": "direction",
          "text": "TAKE — (no number) — there wasn't."
        },
        {
          "id": "flurry.him.8",
          "who": "direction",
          "text": "That was it. That was all you got."
        }
      ]
    }
  }
}
