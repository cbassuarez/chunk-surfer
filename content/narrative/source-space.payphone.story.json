    "unobtainable": {
      "id": "unobtainable",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "unobtainable.1",
          "who": "direction",
          "text": "[Number unobtainable. A single steady tone that does not care.]"
        },
        {
          "id": "unobtainable.2",
          "who": "you",
          "text": "Not a number. Not tonight."
        }
      ]
    },
    "london": {
      "id": "london",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "london.1",
          "who": "direction",
          "text": "[Unobtainable. Oh one is London on this exchange, and London has never heard of it.]"
        },
        {
          "id": "london.2",
          "who": "you",
          "text": "That's the letterhead. It's got a digit this line doesn't have yet."
        }
      ]
    },
    "van-ringing": {
      "id": "van-ringing",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "van-ringing.1",
          "who": "direction",
          "text": "[Ringing. And up the road, faintly through the glass, something in the van is ringing too.]"
        },
        {
          "id": "van-ringing.2",
          "who": "you",
          "text": "That's mine. That's the van."
        }
      ]
    },
    "van-answer": {
      "id": "van-answer",
      "type": "dialogue",
      "speaker": "THE VAN",
      "lines": [
        {
          "id": "van-answer.1",
          "who": "direction",
          "text": "[The car phone, still warm from ringing. Down it: the box you just left. Rain on its glass.]",
          "cue": "phone:answer:van-cab"
        },
        {
          "id": "van-answer.2",
          "who": "direction",
          "text": "[The handset you left, knocking against the glass as it swings.]"
        },
        {
          "id": "van-answer.3",
          "who": "direction",
          "text": "[And under the rain, breathing.]"
        },
        {
          "id": "van-answer.4",
          "who": "you",
          "text": "That's me. That was me a minute ago, standing in there."
        }
      ],
      "choices": [
        {
          "id": "phone.van.leave-off",
          "text": "Leave it off the hook. Let it listen.",
          "goto": "van-offhook",
          "mutations": {
            "set": [
              "phone.van.offhook"
            ]
          }
        },
        {
          "id": "phone.van.hang-up",
          "text": "Put it back.",
          "terminal": true
        }
      ]
    },
    "van-offhook": {
      "id": "van-offhook",
      "type": "dialogue",
      "speaker": "THE VAN",
      "lines": [
        {
          "id": "van-offhook.1",
          "who": "direction",
          "text": "[You lay it on the seat. The box across the road goes on listening to the van.]"
        }
      ]
    },
    "flat": {
      "id": "flat",
      "type": "dialogue",
      "speaker": "HIS FLAT",
      "lines": [
        {
          "id": "flat.1",
          "who": "direction",
          "text": "[Four rings, then the click of a cassette machine starting.]",
          "cue": "phone:answer:flat-machine"
        },
        {
          "id": "flat.2",
          "who": "me",
          "text": "You've got me. I'm not in. Leave it after the tone and I'll ring you back."
        },
        {
          "id": "flat.3",
          "who": "direction",
          "text": "[The tone.]",
          "cue": "phone:beep:beep"
        }
      ],
      "choices": [
        {
          "id": "phone.flat.kept",
          "text": "(it is recording — say what you like)",
          "goto": "flat-kept",
          "when": "phone.voicemail.live"
        },
        {
          "id": "phone.flat.checking",
          "text": "\"It's me. Just checking the machine works.\"",
          "goto": "flat-message",
          "when": "!phone.voicemail.live"
        },
        {
          "id": "phone.flat.where",
          "text": "\"I'm in a phone box. I don't know where. Don't wait up.\"",
          "goto": "flat-message",
          "when": "!phone.voicemail.live"
        },
        {
          "id": "phone.flat.rain",
          "text": "(say nothing, and let it record the rain)",
          "goto": "flat-message",
          "when": "!phone.voicemail.live"
        }
      ]
    },
    "flat-message": {
      "id": "flat-message",
      "type": "dialogue",
      "speaker": "HIS FLAT",
      "lines": [
        {
          "id": "flat-message.1",
          "who": "direction",
          "text": "[It takes it until it has had enough, and clicks off.]",
          "cue": "phone:hang:voicemail-cut"
        }
      ]
    },
    "flat-kept": {
      "id": "flat-kept",
      "type": "dialogue",
      "speaker": "HIS FLAT",
      "lines": [
        {
          "id": "flat-kept.1",
          "who": "direction",
          "text": "[It takes it until you stop.]"
        },
        {
          "id": "flat-kept.2",
          "who": "you",
          "text": "That's on the machine now. Nobody's there to play it."
        }
      ]
    },
    "flat-again": {
      "id": "flat-again",
      "type": "dialogue",
      "speaker": "HIS FLAT",
      "lines": [
        {
          "id": "flat-again.1",
          "who": "me",
          "text": "You've got me. I'm not in."
        },
        {
          "id": "flat-again.2",
          "who": "you",
          "text": "I'm not. That's true."
        }
      ]
    },
    "lyle": {
      "id": "lyle",
      "type": "dialogue",
      "speaker": "A HALL OF RESIDENCE",
      "lines": [
        {
          "id": "lyle.1",
          "who": "direction",
          "text": "[Picked up on the ninth ring. A party at the end of a corridor. Someone singing, a key below the record.]",
          "cue": "phone:answer:hall-party"
        },
        {
          "id": "lyle.2",
          "who": "student",
          "text": "Yeah?"
        }
      ],
      "choices": [
        {
          "id": "phone.lyle.ask",
          "text": "\"Is Lyle there?\"",
          "goto": "lyle-nobody"
        },
        {
          "id": "phone.lyle.silent",
          "text": "(say nothing)",
          "goto": "lyle-silent"
        }
      ]
    },
    "lyle-nobody": {
      "id": "lyle-nobody",
      "type": "dialogue",
      "speaker": "A HALL OF RESIDENCE",
      "lines": [
        {
          "id": "lyle-nobody.1",
          "who": "student",
          "text": "Who?"
        },
        {
          "id": "lyle-nobody.2",
          "who": "student",
          "text": "There's no Lyle here, mate. This is the payphone. Nobody lives at a payphone."
        },
        {
          "id": "lyle-nobody.3",
          "who": "direction",
          "text": "[It is set down on the shelf, not the hook. The party goes on without either of you.]"
        },
        {
          "id": "lyle-nobody.4",
          "who": "you",
          "text": "Second floor. The window that wouldn't shut. He used to sit on the radiator in his green jumper."
        }
      ]
    },
    "lyle-silent": {
      "id": "lyle-silent",
      "type": "dialogue",
      "speaker": "A HALL OF RESIDENCE",
      "lines": [
        {
          "id": "lyle-silent.1",
          "who": "student",
          "text": "Hello? ... Hello?"
        },
        {
          "id": "lyle-silent.2",
          "who": "direction",
          "text": "[Put down.]",
          "cue": "phone:hang:far-clear"
        },
        {
          "id": "lyle-silent.3",
          "who": "you",
          "text": "Same number. Same corridor. Just not us in it."
        }
      ]
    },
    "lyle-again": {
      "id": "lyle-again",
      "type": "dialogue",
      "speaker": "A HALL OF RESIDENCE",
      "lines": [
        {
          "id": "lyle-again.1",
          "who": "direction",
          "text": "[Engaged. Somebody on it already, ringing home.]"
        },
        {
          "id": "lyle-again.2",
          "who": "you",
          "text": "Somebody always is."
        }
      ]
    },
    "sarah": {
      "id": "sarah",
      "type": "dialogue",
      "speaker": "A HALLWAY YOU KNOW",
      "lines": [
        {
          "id": "sarah.1",
          "who": "direction",
          "text": "[Answered on the sixth ring. A hallway you know by its sound.]",
          "cue": "phone:answer:sarah-hall"
        },
        {
          "id": "sarah.2",
          "who": "man",
          "text": "Hello?"
        },
        {
          "id": "sarah.3",
          "who": "direction",
          "text": "[He waits. The hallway waits with him.]"
        },
        {
          "id": "sarah.4",
          "who": "man",
          "text": "Hello? ... Who is this?"
        },
        {
          "id": "sarah.5",
          "who": "direction",
          "text": "[Away from the phone, gently:]"
        },
        {
          "id": "sarah.6",
          "who": "man",
          "text": "Sarah, it's no one."
        },
        {
          "id": "sarah.7",
          "who": "direction",
          "text": "[Put down, carefully, the way you put a phone down in a house where someone is asleep.]",
          "cue": "phone:hang:far-clear"
        },
        {
          "id": "sarah.8",
          "who": "you",
          "text": "No one."
        }
      ]
    },
    "sarah-confessed": {
      "id": "sarah-confessed",
      "type": "dialogue",
      "speaker": "A HALLWAY YOU KNOW",
      "lines": [
        {
          "id": "sarah-confessed.1",
          "who": "direction",
          "text": "[Answered on the sixth ring. A hallway you know by its sound.]",
          "cue": "phone:answer:sarah-hall"
        },
        {
          "id": "sarah-confessed.2",
          "who": "man",
          "text": "Hello?"
        },
        {
          "id": "sarah-confessed.3",
          "who": "direction",
          "text": "[Breathing. Yours, and then his, and he knows whose the first was.]"
        },
        {
          "id": "sarah-confessed.4",
          "who": "man",
          "text": "She's gone up."
        },
        {
          "id": "sarah-confessed.5",
          "who": "direction",
          "text": "[Put down.]",
          "cue": "phone:hang:far-clear"
        },
        {
          "id": "sarah-confessed.6",
          "who": "you",
          "text": "I said that. At the gate. That's what I said."
        }
      ]
    },
    "sarah-unpaid": {
      "id": "sarah-unpaid",
      "type": "dialogue",
      "speaker": "A HALLWAY YOU KNOW",
      "lines": [
        {
          "id": "sarah-unpaid.1",
          "who": "man",
          "text": "Hello? ... You're in a box, I can't hear you. Put your money in."
        },
        {
          "id": "sarah-unpaid.2",
          "who": "direction",
          "text": "[He waits through the pips longer than he has to. Then he doesn't.]",
          "cue": "phone:hang:far-clear"
        }
      ]
    },
    "sarah-again": {
      "id": "sarah-again",
      "type": "dialogue",
      "speaker": "A HALLWAY YOU KNOW",
      "lines": [
        {
          "id": "sarah-again.1",
          "who": "direction",
          "text": "[Engaged. Off the hook, now, in a hallway you know.]"
        },
        {
          "id": "sarah-again.2",
          "who": "you",
          "text": "Off the hook."
        }
      ]
    },
    "sister": {
      "id": "sister",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "sister.1",
          "who": "direction",
          "text": "[It rings, and rings. Nobody is coming down the stairs for this.]"
        },
        {
          "id": "sister.2",
          "who": "you",
          "text": "She knows it's a box. She knows who rings from boxes."
        }
      ]
    },
    "office": {
      "id": "office",
      "type": "dialogue",
      "speaker": "THE PHONE BOX",
      "lines": [
        {
          "id": "office.1",
          "who": "direction",
          "text": "[Eleven rings, in an office with no chairs left in it.]"
        },
        {
          "id": "office.2",
          "who": "you",
          "text": "Same as before."
        }
      ]
    },
    "lodge": {
