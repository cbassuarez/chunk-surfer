  "start": {
   "speaker": "THE GALLERY",
   "lines": [
    {
     "who": "direction",
     "text": "This one sits off-square on its plinth. There is old felt under the base, packed down.",
     "id": "start.line.1"
    },
    {
     "who": "you",
     "text": "Somebody had you off and put you back in a hurry.",
     "id": "start.line.2"
    },
    {
     "who": "direction",
     "text": "Brass in the felt, on its side, where it rolled when a hand let go of it.",
     "id": "start.line.3"
    }
   ],
   "id": "start",
   "type": "dialogue"
  }
 }
