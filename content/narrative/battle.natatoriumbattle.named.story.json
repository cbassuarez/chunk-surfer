  "nodes": {
    "start": {
      "type": "battle",
      "speaker": "THE SOUND OF SILENCE",
      "art": {
        "id": "surfer",
        "mode": "boss",
        "caption": "Signal subject / empty room",
        "status": "STILL"
      },
      "lines": [
        {
          "who": "direction",
          "text": "Forty seconds into the take. Six metres of tile, no water, and the meter dead flat at the bottom of the scale.",
          "id": "start.line.1"
        },
        {
          "who": "direction",
          "text": "And then, far off, a piano. Two notes. The wrong two notes.",
          "id": "start.line.2",
          "cues": [
            "piano.diegetic.01"
          ]
        },
        {
          "who": "you",
          "text": "There is no piano in a natatorium.",
          "id": "start.line.3"
        },
        {
          "who": "you",
          "text": "There is no piano in a building that has had its power off since April.",
          "id": "start.line.4"
        }
      ],
      "goto": "round-1",
      "id": "start"
    },
    "round-1": {
      "type": "battle-round",
      "lines": [
        {
          "who": "direction",
          "text": "It comes again. Closer, or louder, or you are leaning towards it — you cannot tell which, and not being able to tell which is the whole of the problem.",
          "channel": "before",
          "id": "round-1.line.1",
          "cues": [
            "piano.diegetic.02"
          ]
        },
        {
          "who": "you",
          "text": "No transient. No air moving. No felt on a string.",
          "channel": "on-listen",
          "id": "round-1.line.2"
        },
        {
          "who": "you",
          "text": "There is nothing there. There is nothing there and I can hear it.",
          "channel": "on-listen",
          "id": "round-1.line.3"
        },
        {
          "who": "direction",
          "text": "The tile gives it back to you four times and each return is thinner than the last.",
          "channel": "after",
          "id": "round-1.line.4",
          "cues": [
            "piano.diegetic.03"
          ]
        }
      ],
      "goto": "round-2",
      "battle": {
        "nature": "not there",
        "threat": 0.42
      },
      "id": "round-1"
    },
    "round-2": {
      "type": "battle-round",
      "lines": [
        {
          "who": "sarah",
          "text": "Don’t record this.",
          "rate": 0.98,
          "channel": "before",
          "id": "round-2.line.1"
        },
        {
          "who": "me",
          "text": "I'm not recording.",
          "channel": "before",
          "id": "round-2.line.2"
        },
        {
          "who": "sarah",
          "text": "You're always recording.",
          "channel": "before",
          "id": "round-2.line.3"
        },
        {
          "who": "direction",
          "text": "She is right. The meter is moving.",
          "channel": "before",
          "id": "round-2.line.4"
        },
        {
          "who": "you",
          "text": "That is a take. That is a level and a room and a date, and I made it, and I do not remember making it.",
          "channel": "on-listen",
          "id": "round-2.line.5"
        },
        {
          "who": "you",
          "text": "Sarah hated the playback. Six years of rooms with nobody in them, and I never once asked myself why that suited me.",
          "channel": "on-listen",
          "id": "round-2.line.6"
        },
        {
          "who": "you",
          "text": "I recorded Sarah for three years and I called it not recording.",
          "channel": "after",
          "id": "round-2.line.7"
        }
      ],
      "goto": "round-3",
      "battle": {
        "nature": "on the tape",
        "threat": 0.6
      },
      "id": "round-2"
    },
    "round-3": {
      "type": "battle-round",
      "lines": [
        {
          "who": "sarah",
          "text": "You never played me back. Not once. I used to think it was kindness.",
          "rate": 0.97,
          "channel": "before",
          "id": "round-3.line.1"
        },
        {
          "who": "me",
          "text": "It was. You hated it.",
          "channel": "before",
          "id": "round-3.line.2"
        },
        {
          "who": "sarah",
          "text": "I hated hearing myself. You liked that I hated it. It meant you got to keep me the way you kept a room.",
          "channel": "before",
          "id": "round-3.line.3"
        },
        {
          "who": "you",
          "text": "She is not in the room. She is not on the tape. She was never in the signal at all.",
          "channel": "on-listen",
          "id": "round-3.line.4"
        },
        {
          "who": "you",
          "text": "I brought her in here. This is the one recording I have ever made that has me all over it.",
          "channel": "on-listen",
          "id": "round-3.line.5"
        },
        {
          "who": "direction",
          "text": "The meter, which has never lied to you, sits at the bottom of the scale, and there is nobody in the room but you.",
          "channel": "after",
          "id": "round-3.line.6"
        }
      ],
      "goto": "outcome",
      "battle": {
        "nature": "not there",
        "threat": 0.72
      },
      "id": "round-3"
    },
    "outcome": {
      "type": "checkpoint",
      "lines": [],
      "choices": [
        {
          "id": "outcome.win",
          "text": "Composure held",
          "goto": "win",
          "mechanic": "win"
        },
        {
          "id": "outcome.lose",
          "text": "Composure broke",
          "goto": "lose",
          "mechanic": "lose"
        }
      ],
      "id": "outcome"
    },
    "win": {
      "type": "ending",
      "lines": [
        {
          "who": "you",
          "text": "Nothing there. It fed me a piano and I fed it back its own empty room until the meter agreed.",
          "id": "win.line.1"
        },
        {
          "who": "direction",
          "text": "The tile stops answering. The meter holds. You have a clean minute of a room with only you in it, which is the job, which was always the job.",
          "id": "win.line.2"
        }
      ],
      "id": "win"
    },
    "lose": {
      "type": "ending",
      "lines": [
        {
          "who": "direction",
          "text": "Your composure goes between beats. You are answering the piano before you know you have moved.",
          "id": "lose.line.1"
        },
        {
          "who": "direction",
          "text": "The take dies. Somewhere far off, satisfied, the room stops playing.",
          "id": "lose.line.2"
        }
      ],
      "id": "lose"
    }
  },
