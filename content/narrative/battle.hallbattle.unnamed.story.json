  "nodes": {
    "start": {
      "type": "battle",
      "speaker": "THE HOUSE RETURN",
      "art": {
        "id": "circuitBentInterface",
        "mode": "boss",
        "caption": "House return / monitor path",
        "status": "SIGNAL"
      },
      "lines": [
        {
          "who": "direction",
          "text": "The hall takes your silence and returns it from the stage, the balconies, and the empty seats.",
          "id": "start.line.1"
        },
        {
          "who": "you",
          "text": "That is a return. That is architecture. Keep it architecture.",
          "id": "start.line.2"
        },
        {
          "who": "direction",
          "text": "A voice uses the return without entering the room.",
          "id": "start.line.3"
        }
      ],
      "goto": "round-1",
      "id": "start"
    },
    "outcome": {
      "type": "checkpoint",
      "lines": [],
      "choices": [
        {
          "id": "outcome.win",
          "text": "Composure held",
          "goto": "win",
          "mechanic": "win"
        },
        {
          "id": "outcome.lose",
          "text": "Composure broke",
          "goto": "lose",
          "mechanic": "lose"
        }
      ],
      "id": "outcome"
    },
    "win": {
      "type": "ending",
      "lines": [
        {
          "who": "you",
          "text": "Empty hall. Empty stage. A long return and nothing inside it.",
          "id": "win.line.1"
        },
        {
          "who": "direction",
          "text": "The last reflection decays below the machine noise.",
          "id": "win.line.2"
        }
      ],
      "id": "win"
    },
    "lose": {
      "type": "ending",
      "lines": [
        {
          "who": "direction",
          "text": "You answer the return. The hall keeps the answer.",
          "id": "lose.line.1"
        },
        {
          "who": "direction",
          "text": "The take dies with a full house listening.",
          "id": "lose.line.2"
        }
      ],
      "id": "lose"
    },
    "round-1": {
      "type": "battle-round",
      "lines": [
        {
          "who": "direction",
          "text": "The desk is dead and the send is live anyway. Whatever is on the house fader, it is being offered to you like a level to set.",
          "channel": "before",
          "id": "round-1.line.1"
        },
        {
          "who": "you",
          "text": "That is my own noise floor coming back off the stage. It is selling me my silence as a performance.",
          "channel": "on-listen",
          "id": "round-1.line.2"
        },
        {
          "who": "you",
          "text": "Take the send. If it wants to broadcast, it can go on my tape, at my level.",
          "channel": "on-listen",
          "id": "round-1.line.3"
        },
        {
          "who": "direction",
          "text": "The return thins. A hall this size should not know your kit by name.",
          "channel": "after",
          "id": "round-1.line.4"
        }
      ],
      "goto": "round-2",
      "battle": {
        "nature": "on the tape",
        "threat": 0.46
      },
      "id": "round-1"
    },
    "round-2": {
      "type": "battle-round",
      "lines": [
        {
          "who": "direction",
          "text": "The house return comes up patched to itself — output into input, a loop with no player in it.",
          "channel": "before",
          "id": "round-2.line.1"
        },
        {
          "who": "direction",
          "text": "A voice uses the loop without entering the room.",
          "channel": "before",
          "id": "round-2.line.2"
        },
        {
          "who": "direction",
          "text": "You do what thirty years has trained you to do and take a bearing on it. It is not on the stage and it is not in the seats. It is above and behind you, off the upper tier, where the return arrives a beat late because it has further to fall.",
          "channel": "before",
          "id": "round-2.line.5"
        },
        {
          "who": "you",
          "text": "Upper balcony. Whatever is using this room is using it from up there, and it has been up there the whole time I have been setting levels underneath it.",
          "channel": "on-listen",
          "id": "round-2.line.6"
        },
        {
          "who": "you",
          "text": "Feedback is not a ghost. Feedback is a fault. Break the loop or bend it back.",
          "channel": "on-listen",
          "id": "round-2.line.3"
        },
        {
          "who": "direction",
          "text": "The loop closes on nothing and eats its own tail quietly.",
          "channel": "after",
          "id": "round-2.line.4"
        }
      ],
      "goto": "round-3",
      "battle": {
        "nature": "not there",
        "threat": 0.6
      },
      "id": "round-2"
    },
    "round-3": {
      "type": "battle-round",
      "lines": [
        {
          "who": "direction",
          "text": "Under the noise floor, applause. Rows of it. The hall is giving you the audience it thinks you came for.",
          "channel": "before",
          "id": "round-3.line.1"
        },
        {
          "who": "direction",
          "text": "The applause is loudest from the tier you cannot see the front of. Every hand in it is seven and a half metres above your head.",
          "channel": "before",
          "id": "round-3.line.4"
        },
        {
          "who": "you",
          "text": "Nobody is sitting there. Nobody has sat there since April. I am not taking a bow for a room tone.",
          "channel": "on-listen",
          "id": "round-3.line.2"
        },
        {
          "who": "direction",
          "text": "The applause runs out of hands. What is left is architecture, decaying at the speed architecture decays.",
          "channel": "after",
          "id": "round-3.line.3"
        }
      ],
      "goto": "outcome",
      "battle": {
        "nature": "not there",
        "threat": 0.74
      },
      "id": "round-3"
    }
  },
