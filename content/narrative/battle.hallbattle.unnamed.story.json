      "lines": [
        {
          "who": "direction",
          "text": "The hall takes your silence and returns it from the stage, the balconies, and the empty seats.",
          "id": "start.line.1"
        },
        {
          "who": "you",
          "text": "That is a return. That is architecture. Keep it architecture.",
          "id": "start.line.2"
        },
        {
          "who": "direction",
          "text": "A voice uses the return without entering the room.",
          "id": "start.line.3"
        }
