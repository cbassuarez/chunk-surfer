  "nodes": {
    "start": {
      "type": "battle",
      "speaker": "THE SOUND OF SILENCE",
      "art": {
        "id": "tuningFork",
        "mode": "boss",
        "caption": "Reference tone / wrong music",
        "status": "REFERENCE"
      },
      "lines": [
        {
          "who": "direction",
          "text": "Forty seconds into the take. Eight practice rooms and the ensemble room off one corridor, every door open. Seven uprights with their lids up; stands and cases in the rooms without them.",
          "id": "start.line.1"
        },
        {
          "who": "direction",
          "text": "And then, far off, music. Not a note struck — music, playing, the way it plays from another room in a house.",
          "id": "start.line.2"
        },
        {
          "who": "you",
          "text": "There is no power in this building. There is no one in this building.",
          "id": "start.line.3"
        },
        {
          "who": "you",
          "text": "Is it a recording. It sounds like a recording. Whose recording.",
          "id": "start.line.4"
        }
      ],
      "goto": "round-1",
      "id": "start"
    },
    "round-1": {
      "type": "battle-round",
      "lines": [
        {
          "who": "direction",
          "text": "It resolves, for a second, into something you know. A phrase. A room, years ago, a phone left running on a table.",
          "channel": "before",
          "id": "round-1.line.1"
        },
        {
          "who": "you",
          "text": "That is off a file. That is off one of my files. I have it. It is on a drive in a box in a spare room.",
          "channel": "on-listen",
          "id": "round-1.line.2"
        },
        {
          "who": "you",
          "text": "I recorded Sarah for three years and called it not recording, and I kept every second of it.",
          "channel": "on-listen",
          "id": "round-1.line.3"
        },
        {
          "who": "you",
          "text": "She never once said I could. It never once occurred to me to ask.",
          "channel": "after",
          "id": "round-1.line.4"
        }
      ],
      "goto": "round-2",
      "battle": {
        "nature": "on the tape",
        "threat": 0.46
      },
      "id": "round-1"
    },
    "round-2": {
      "type": "battle-round",
      "lines": [
        {
          "who": "sarah",
          "text": "You have hours of me. You know that, don’t you. Hours.",
          "rate": 0.97,
          "channel": "before",
          "id": "round-2.line.1"
        },
        {
          "who": "me",
          "text": "They’re just — they’re the house. You in the house. I never did anything with them.",
          "channel": "before",
          "id": "round-2.line.2"
        },
        {
          "who": "sarah",
          "text": "You kept them. You keep rooms nobody will stand in again. You kept me the same way. You think accepting my transition is some noble work but you couldn't accept any other part of me.",
          "channel": "before",
          "id": "round-2.line.3"
        },
        {
          "who": "you",
          "text": "She is not here. She is on a drive, in a box... you're hallucinating again. You can stop it.",
          "channel": "on-listen",
          "id": "round-2.line.4"
        },
        {
          "who": "direction",
          "text": "The pianos do not move. Seven uprights, lids up, many strings popped. Some of them still sound like pianos.",
          "channel": "after",
          "id": "round-2.line.5"
        }
      ],
      "goto": "round-3",
      "battle": {
        "nature": "not there",
        "threat": 0.6
      },
      "id": "round-2"
    },
    "round-3": {
      "type": "battle-round",
      "lines": [
        {
          "who": "sarah",
          "text": "Play one back. Go on. You never would, when I could hear you do it.",
          "rate": 0.95,
          "channel": "before",
          "id": "round-3.line.1"
        },
        {
          "who": "you",
          "text": "No.",
          "channel": "before",
          "id": "round-3.line.2"
        },
        {
          "who": "sarah",
          "text": "Because then it would be me, and you would have to have heard me, and you never did.",
          "channel": "before",
          "id": "round-3.line.3"
        },
        {
          "who": "you",
          "text": "I will play this wing back its own phrase all night. Not yours.",
          "channel": "before",
          "id": "round-3.line.own-phrase"
        },
        {
          "who": "you",
          "text": "Nothing there. Nothing in the room. The room is empty and I filled it, and I am the only thing on this take.",
          "channel": "on-listen",
          "id": "round-3.line.4"
        },
        {
          "who": "you",
          "text": "Hold it. Hold the take. Do not give it what it is asking for.",
          "channel": "after",
          "id": "round-3.line.5"
        }
      ],
      "goto": "outcome",
      "battle": {
        "nature": "not there",
        "threat": 0.72
      },
      "id": "round-3"
    },
    "outcome": {
      "type": "checkpoint",
      "lines": [],
      "choices": [
        {
          "id": "outcome.win",
          "text": "Composure held",
          "goto": "win",
          "mechanic": "win"
        },
        {
          "id": "outcome.lose",
          "text": "Composure broke",
          "goto": "lose",
          "mechanic": "lose"
        }
      ],
      "id": "outcome"
    },
    "win": {
      "type": "ending",
      "lines": [
        {
          "who": "you",
          "text": "Nothing there. Its own phrase, handed back to it enough times, and it stopped believing itself.",
          "id": "win.line.1"
        },
        {
          "who": "direction",
          "text": "The far room stops playing. The pianos are pianos. The empty rooms are empty. You have a clean minute of a wing with only you in it, and a box at home you are going to open when you get back, and delete.",
          "id": "win.line.2"
        }
      ],
      "id": "win"
    },
    "lose": {
      "type": "ending",
      "lines": [
        {
          "who": "direction",
          "text": "Your hand is already on the transport, and it is not the wing’s take it reaches for. It is the box in the spare room. It is her.",
          "id": "lose.line.1"
        },
        {
          "who": "direction",
          "text": "The take dies. Somewhere, a phrase you know finishes, and is not played again.",
          "id": "lose.line.2"
        }
      ],
      "id": "lose"
    }
  },
