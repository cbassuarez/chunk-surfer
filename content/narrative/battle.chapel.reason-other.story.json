  "nodes": {
    "start": {
      "type": "battle",
      "speaker": "THE REASON YOU CAME",
      "art": {
        "id": "circuitBentInterface",
        "mode": "boss",
        "caption": "Damaged monitor path / chapel",
        "status": "SIGNAL"
      },
      "lines": [
        {
          "who": "direction",
          "text": "The chapel. Two banks of pews, an organ with the wind isolated, and the fifth room tone you were sent for.",
          "id": "start.line.1",
          "cues": [
            "freeze"
          ]
        },
        {
          "who": "recordist",
          "text": "Take five.",
          "id": "start.line.2"
        },
        {
          "who": "surfer",
          "text": "Take five.",
          "rate": 0.94,
          "id": "start.line.3"
        },
        {
          "who": "surfer",
          "text": "COME CLOSER",
          "rate": 0.94,
          "id": "start.line.callback"
        },
        {
          "who": "you",
          "text": "There are two of them in here and one of them is me in eleven years.",
          "id": "start.line.4"
        },
        {
          "who": "direction",
          "text": "It has put on a face while you were not looking. It is wearing the reason you came.",
          "id": "start.line.5"
        }
      ],
      "goto": "round-1",
      "id": "start"
    },
    "round-1": {
      "type": "battle-round",
      "lines": [
        {
          "who": "surfer",
          "text": "Say the reason again. Say it the way you said it in the dark.",
          "rate": 0.98,
          "channel": "before",
          "id": "round-1.line.1"
        },
        {
          "who": "direction",
          "text": "It is waiting for you to agree with it. Agreeing is the only thing it cannot do for itself.",
          "channel": "before",
          "id": "round-1.line.3"
        },
        {
          "who": "you",
          "text": "No transient. No breath. No felt, no reed, no room.",
          "channel": "on-listen",
          "id": "round-1.line.4"
        },
        {
          "who": "you",
          "text": "There is nothing there, and it is speaking to me in a voice I have missed.",
          "channel": "on-listen",
          "id": "round-1.line.5"
        },
        {
          "who": "direction",
          "text": "The pews return it four times, and each return is more certain than you are.",
          "channel": "after",
          "id": "round-1.line.6"
        }
      ],
      "battle": {
        "nature": "not there",
        "threat": 0.5
      },
      "id": "round-1",
      "goto": "round-2"
    },
    "round-2": {
      "type": "battle-round",
      "lines": [
        {
          "who": "recordist",
          "text": "I did the first four. You did the chapel. They said it did not matter who, so long as it was somebody.",
          "channel": "before",
          "id": "round-2.line.1"
        },
        {
          "who": "you",
          "text": "...four and one. Yours and mine. It overlapped.",
          "channel": "before",
          "id": "round-2.line.2"
        },
        {
          "who": "you",
          "text": "That is a take. That is a level and a room and a date, and the date is wrong by eleven years.",
          "channel": "on-listen",
          "id": "round-2.line.3"
        },
        {
          "who": "you",
          "text": "He is not haunting me. He is the reference file, and I am the room he is playing in.",
          "channel": "on-listen",
          "id": "round-2.line.4"
        },
        {
          "who": "recordist",
          "text": "One more and I am out of here. That is what I said too.",
          "channel": "after",
          "id": "round-2.line.5"
        }
      ],
      "goto": "round-3",
      "battle": {
        "nature": "on the tape",
        "threat": 0.66
      },
      "id": "round-2"
    },
    "round-3": {
      "type": "battle-round",
      "lines": [
        {
          "who": "surfer",
          "text": "Then bring me one. Bring me the one you lost and I will let the rest of it be nothing.",
          "rate": 0.97,
          "channel": "before",
          "id": "round-3.line.1"
        },
        {
          "who": "surfer",
          "text": "It listened until language was an encumbrance. It became the music. Then it wanted a body back. You are a body.",
          "channel": "before",
          "id": "round-3.line.2"
        },
        {
          "who": "direction",
          "text": "The organ blower is off and the organ is sounding anyway.",
          "channel": "before",
          "id": "round-3.line.3"
        },
        {
          "who": "you",
          "text": "It wants me to agree that the work was ever about anything but the work.",
          "channel": "on-listen",
          "id": "round-3.line.4"
        },
        {
          "who": "you",
          "text": "I record rooms with nobody in them. It never once occurred to me that this suited me. That is not a wound. That is a man who is bad at something.",
          "channel": "on-listen",
          "id": "round-3.line.5"
        },
        {
          "who": "direction",
          "text": "The meter, which has never lied to you, sits flat at the bottom of the scale.",
          "channel": "after",
          "id": "round-3.line.6"
        }
      ],
      "battle": {
        "nature": "not there",
        "threat": 0.8
      },
      "id": "round-3",
      "goto": "round-4"
    },
    "round-4": {
      "type": "battle-round",
      "lines": [
        {
          "who": "surfer",
          "text": "Everybody has lost somebody.",
          "channel": "before",
          "id": "round-4.line.1"
        },
        {
          "who": "me",
          "text": "No.",
          "channel": "before",
          "id": "round-4.line.2"
        },
        {
          "who": "surfer",
          "text": "...no?",
          "channel": "before",
          "id": "round-4.line.3"
        },
        {
          "who": "me",
          "text": "No. I came here to record five rooms. I have recorded five rooms.",
          "channel": "before",
          "id": "round-4.line.4"
        },
        {
          "who": "you",
          "text": "It is not in the room. It is not on the tape. It was never in the signal at all.",
          "channel": "on-listen",
          "id": "round-4.line.5"
        },
        {
          "who": "you",
          "text": "Five of five listened. So did it. It has been at the level of the room the whole time.",
          "channel": "on-listen",
          "id": "round-4.line.6"
        },
        {
          "who": "direction",
          "text": "It has run out of faces to wear. There is only the one it started with, which is his.",
          "channel": "after",
          "id": "round-4.line.7"
        }
      ],
      "goto": "round-5",
      "battle": {
        "nature": "not there",
        "threat": 0.92
      },
      "id": "round-4"
    },
    "outcome": {
      "type": "checkpoint",
      "lines": [],
      "choices": [
        {
          "id": "outcome.win",
          "text": "Composure held",
          "goto": "win",
          "mechanic": "win"
        },
        {
          "id": "outcome.lose",
          "text": "Composure broke",
          "goto": "lose",
          "mechanic": "lose"
        }
      ],
      "id": "outcome"
    },
    "win": {
      "type": "ending",
      "lines": [
        {
          "who": "you",
          "text": "Nothing there. Hold it. Five clean rooms and the last one has only me in it.",
          "id": "win.line.1"
        },
        {
          "who": "direction",
          "text": "The organ stops. The face it was wearing does not come off so much as stop being worn. Both of them are looking at you now, and it is your move.",
          "id": "win.line.2"
        }
      ],
      "id": "win"
    },
    "lose": {
      "type": "ending",
      "lines": [
        {
          "who": "direction",
          "text": "You agree with it. You do not decide to; you are nodding before you know it.",
          "id": "lose.line.1"
        },
        {
          "who": "surfer",
          "text": "There. That did not cost you anything you were using.",
          "id": "lose.line.2"
        },
        {
          "who": "direction",
          "text": "The take dies. It has a body back, and the body is yours, and it fits.",
          "id": "lose.line.3"
        }
      ],
      "id": "lose"
    },
    "round-5": {
      "type": "battle-round",
      "lines": [
        {
          "who": "surfer",
          "text": "Last page. The source is holding the pen out to you.",
          "channel": "before",
          "id": "round-5.line.1",
          "rate": 0.94
        },
        {
          "who": "recordist",
          "text": "Sign it or read it. I signed.",
          "channel": "before",
          "id": "round-5.line.2",
          "rate": 0.98
        },
        {
          "who": "you",
          "text": "It is not a contract. It is a room tone with terms in it. I record rooms. I do not agree with them.",
          "channel": "on-listen",
          "id": "round-5.line.3"
        },
        {
          "who": "you",
          "text": "Play it its own clause. Turn the loop around. Whatever proof I leave here is the proof I choose.",
          "channel": "on-listen",
          "id": "round-5.line.4"
        },
        {
          "who": "direction",
          "text": "The organ swallows the last word of its own sentence. The chapel is measurably smaller than its blueprint now.",
          "channel": "after",
          "id": "round-5.line.5"
        }
      ],
      "goto": "outcome",
      "battle": {
        "nature": "not there",
        "threat": 0.98
      },
      "id": "round-5"
    }
  },
