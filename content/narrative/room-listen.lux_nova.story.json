  "nodes": {
    "start": {
      "speaker": "",
      "lines": [
        {
          "who": "direction",
          "text": "Headphones on. {label} comes up in the cans — stone, ribbed vault, cold you can hear, and somewhere overhead a broken pane letting the weather in.",
          "id": "start.line.1"
        },
        {
          "who": "you",
          "text": "That is the level. That is the room.",
          "id": "start.line.2"
        }
      ],
      "choices": [
        {
          "text": "the tail",
          "goto": "ex0",
          "hideWhenAsked": false,
          "id": "start.choice.1"
        },
        {
          "text": "the broken pane",
          "goto": "ex1",
          "hideWhenAsked": false,
          "id": "start.choice.2"
        },
        {
          "text": "kill the light and roll",
          "goto": "roll",
          "id": "start.choice.3"
        }
      ],
      "id": "start",
      "type": "choice"
    },
    "roll": {
      "speaker": "",
      "lines": [
        {
          "who": "direction",
          "text": "You kill the light. The room drops out of the cans, the tape hiss comes up, and there is you and forty-five seconds and nothing else.",
          "id": "roll.line.1"
        },
        {
          "who": "you",
          "text": "Sixty seconds of nothing, with nothing added. Do not move.",
          "id": "roll.line.2"
        }
      ],
      "id": "roll",
      "type": "dialogue"
    },
    "ex0": {
      "speaker": "",
      "lines": [
        {
          "who": "you",
          "text": "Eleven seconds of reverb, maybe twelve. Stone gives everything back to you long after you have stopped saying it.",
          "id": "ex0.line.1"
        },
        {
          "who": "you",
          "text": "You have to hold still a long time in a room like this. The room keeps talking after you stop.",
          "id": "ex0.line.2"
        }
      ],
      "goto": "start",
      "id": "ex0",
      "type": "dialogue"
    },
    "ex1": {
      "speaker": "",
      "lines": [
        {
          "who": "direction",
          "text": "High up, a clerestory window gone, and the weather coming in through it — snow, tonight, indoors, drifting down onto stone.",
          "id": "ex1.line.1"
        },
        {
          "who": "you",
          "text": "This is the fifth room. This is his room.",
          "id": "ex1.line.2"
        }
      ],
      "goto": "start",
      "id": "ex1",
      "type": "dialogue"
    }
  }
