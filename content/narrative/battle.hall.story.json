  "nodes": {
    "start": {
      "type": "battle",
      "speaker": "THE THREE",
      "art": {
        "id": "tuningFork",
        "mode": "boss",
        "caption": "Reference tone / house return",
        "status": "REFERENCE"
      },
      "lines": [
        {
          "who": "direction",
          "text": "The hall returns your silence from three occupied seats: Row F, the stalls, and a side box.",
          "id": "start.line.1"
        },
        {
          "who": "you",
          "text": "That is a return. That is architecture. Keep it architecture.",
          "id": "start.line.2"
        },
        {
          "who": "direction",
          "text": "Three shapes remain seated. Each chair has grown through the body that loved the piece enough not to leave.",
          "id": "start.line.3"
        },
        {
          "who": "you",
          "text": "That is going on the take whether I like it or not. Forty seconds of it, at my level, with my name on the file.",
          "when": "battle.occasion == recording-2",
          "id": "start.line.4.held"
        },
        {
          "who": "you",
          "text": "The recorder is in the bag and the bag is by the door. Whatever this is, there will be no file of it.",
          "when": "battle.occasion == pre-recording-4",
          "id": "start.line.4.ambush"
        }
      ],
      "goto": "round-1",
      "id": "start"
    },
    "round-1": {
      "type": "battle-round",
      "lines": [
        {
          "who": "direction",
          "text": "The desk is dead and the send is live anyway. Whatever is on the house fader is coming up on its own.",
          "channel": "before",
          "id": "round-1.line.1"
        },
        {
          "who": "you",
          "text": "Three people are in the seats. The seats are in them too.",
          "channel": "on-listen",
          "id": "round-1.line.2"
        },
        {
          "who": "you",
          "text": "Count them. Always count. Three. The number holds. The bodies do not.",
          "channel": "on-listen",
          "id": "round-1.line.3"
        },
        {
          "who": "you",
          "text": "Still rolling. Still rolling.",
          "channel": "on-listen",
          "when": "battle.occasion == recording-2",
          "id": "round-1.bark.held"
        },
        {
          "who": "you",
          "text": "Nothing rolling. Nobody’s version of this but mine.",
          "channel": "on-listen",
          "when": "battle.occasion == pre-recording-4",
          "id": "round-1.bark.ambush"
        },
        {
          "who": "direction",
          "text": "Not one of them is looking at the stage.",
          "channel": "after",
          "id": "round-1.line.4"
        }
      ],
      "battle": {
        "nature": "on the tape",
        "threat": 0.44
      },
      "goto": "round-2",
      "id": "round-1"
    },
    "round-2": {
      "type": "battle-round",
      "lines": [
        {
          "who": "direction",
          "text": "You touch the fader, and every head in the building moves together, a beat late.",
          "channel": "before",
          "id": "round-2.line.1"
        },
        {
          "who": "sarah",
          "text": "Row F. You had the recorder on your knee. You were setting a level while I said it.",
          "channel": "before",
          "when": "battle.naming == yes",
          "id": "round-2.line.2.named"
        },
        {
          "who": "direction",
          "text": "A voice uses the return without entering the room.",
          "channel": "before",
          "when": "battle.naming == no",
          "id": "round-2.line.2.unnamed"
        },
        {
          "who": "you",
          "text": "Not a crowd. Three people. Row F first, then the stalls, then the box.",
          "channel": "on-listen",
          "id": "round-2.line.3"
        },
        {
          "who": "you",
          "text": "Feedback is not a ghost. Feedback is a fault. But a fault does not sit down.",
          "channel": "on-listen",
          "id": "round-2.line.4"
        },
        {
          "who": "direction",
          "text": "They wait in strict order. Each one moves when the last one finishes.",
          "channel": "after",
          "id": "round-2.line.5"
        }
      ],
      "battle": {
        "nature": "not there",
        "threat": 0.52
      },
      "goto": "round-3",
      "id": "round-2"
    },
    "round-3": {
      "type": "battle-round",
      "lines": [
        {
          "who": "direction",
          "text": "Applause. Three sets of hands, each still attached to a chair.",
          "channel": "before",
          "id": "round-3.line.1"
        },
        {
          "who": "direction",
          "text": "They are applauding you. Not the stage. You, at the desk, with a bag and a boom pole.",
          "channel": "before",
          "id": "round-3.line.2"
        },
        {
          "who": "you",
          "text": "I am not the act. I have never once been the act.",
          "channel": "on-listen",
          "id": "round-3.line.3"
        },
        {
          "who": "you",
          "text": "I record rooms. I do not take a bow in them.",
          "channel": "on-listen",
          "id": "round-3.line.4"
        },
        {
          "who": "you",
          "text": "It does not want a take. It wants a performance, and it has picked me to give one.",
          "channel": "after",
          "id": "round-3.line.5"
        }
      ],
      "battle": {
        "nature": "not there",
        "threat": 0.6
      },
      "goto": "outcome",
      "id": "round-3"
    },
    "outcome": {
      "type": "checkpoint",
      "lines": [],
      "choices": [
        {
          "id": "outcome.win",
          "text": "Composure held",
          "goto": "win",
          "mechanic": "win"
        },
        {
          "id": "outcome.lose",
          "text": "Composure broke",
          "goto": "lose",
          "mechanic": "lose"
        }
      ],
      "id": "outcome"
    },
    "win": {
      "type": "ending",
      "lines": [
        {
          "who": "you",
          "text": "They were an audience once. They loved one piece so completely that leaving the seat stopped being possible.",
          "id": "win.line.1"
        },
        {
          "who": "direction",
          "text": "The last reflection decays below the machine noise. You have a clean minute of a room that wanted you to stand up in it.",
          "when": "battle.occasion == recording-2",
          "id": "win.line.2.held"
        },
        {
          "who": "direction",
          "text": "The last reflection decays below the machine noise. Unrecorded, and you stayed in your chair anyway.",
          "when": "battle.occasion == pre-recording-4",
          "id": "win.line.2.ambush"
        }
      ],
      "id": "win"
    },
    "lose": {
      "type": "ending",
      "lines": [
        {
          "who": "direction",
          "text": "You bow. It is a small bow, barely a nod, and it is the most anyone in this building has got out of you all night.",
          "id": "lose.line.1"
        },
        {
          "who": "direction",
          "text": "The take dies with three former listeners still in their seats.",
          "when": "battle.occasion == recording-2",
          "id": "lose.line.2.held"
        },
        {
          "who": "direction",
          "text": "There is no take to die. The house keeps you instead, for as long as it wants, and then lets you go.",
          "when": "battle.occasion == pre-recording-4",
          "id": "lose.line.2.ambush"
        }
      ],
      "id": "lose"
    }
  },
