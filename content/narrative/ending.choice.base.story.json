      ]
    }
  ],
  "nodes": {
    "start": {
      "speaker": "THE CHAPEL",
      "lines": [
        {
          "who": "direction",
          "text": "It is not attacking any more. It is waiting, the recorder still running on the floor between the three of you.",
          "id": "start.line.1"
        },
        {
          "who": "direction",
          "text": "The last page is legible only where the marker did not touch it.",
          "id": "start.line.2"
        },
        {
          "who": "surfer",
          "text": "Well. Bring me one.",
          "id": "start.line.3"
        }
      ],
      "choices": [
        {
          "text": "Give the room the agreement it is asking for.",
          "goto": "feed",
          "id": "start.choice.1",
          "mutations": {
            "set": [
              "ending.choice=sacrifice"
            ]
          }
        },
        {
          "text": "Refuse to author another line.",
          "goto": "nothing",
          "id": "start.choice.2"
        }
      ],
      "id": "start",
      "type": "choice"
    },
    "nothing": {
      "speaker": "THE CHAPEL",
      "lines": [
        {
          "who": "you",
          "text": "There is nothing there.",
          "id": "nothing.line.1"
        },
        {
          "who": "direction",
          "text": "You hold it. A room can wait longer than a man can, and it knows the number.",
          "id": "nothing.line.2"
        }
      ],
      "choices": [
        {
          "text": "Give the room the agreement it is asking for.",
          "goto": "feed",
          "id": "nothing.choice.1",
          "mutations": {
            "set": [
              "ending.choice=sacrifice"
            ]
          }
        }
      ],
      "id": "nothing",
      "type": "choice"
    },
    "feed": {
      "speaker": "THE CHAPEL",
      "lines": [
        {
          "who": "you",
          "text": "All right. All right. Here — take it.",
          "id": "feed.line.1"
        },
        {
          "who": "surfer",
          "text": "There. See. A clear reading.",
          "id": "feed.line.2"
        }
      ],
      "id": "feed",
      "type": "dialogue",
      "exit": "done"
    },
    "invert": {
      "speaker": "THE CHAPEL",
      "lines": [
        {
          "who": "you",
          "text": "No. The source is not a body. It is a signal with a habit of asking.",
          "id": "invert.line.1"
        },
        {
          "who": "direction",
          "text": "The bent recorder plays the room back to itself, and the agreement loses its addressee.",
          "id": "invert.line.2"
        }
      ],
      "id": "invert",
      "type": "dialogue",
      "exit": "done"
    },
    "surface": {
      "speaker": "THE CHAPEL",
      "lines": [
        {
          "who": "you",
          "text": "No. That body is not an instrument.",
          "id": "surface.line.1"
        },
        {
          "who": "recordist",
          "text": "Then make the room read it.",
          "id": "surface.line.2"
        },
        {
          "who": "direction",
          "text": "The tuning fork sounds once, and the room loses the line it was using to stand upright.",
          "id": "surface.line.3"
        }
      ],
      "id": "surface",
      "type": "dialogue",
      "exit": "done"
    }
  }
}
