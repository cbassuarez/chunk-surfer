    "stop-call": {
      "id": "stop-call",
      "type": "dialogue",
      "lines": []
    },
    "opening": {
      "id": "opening",
      "type": "dialogue",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / front desk relay",
        "status": "LIVE"
      },
      "lines": [
        {
          "id": "opening.line.1",
          "who": "me",
          "text": "Martin, route check. Where am I going?"
        },
        {
          "id": "opening.line.2",
          "who": "radio",
          "text": "{ROUTEFIRST}"
        },
        {
          "id": "opening.line.3",
          "who": "radio",
          "text": "Take your time with the plan. Call me from a landing if you lose the signs."
        }
      ]
    },
    "route-first": {
      "id": "route-first",
      "type": "dialogue",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / route desk",
        "status": "LIVE"
      },
      "lines": [
        {
          "id": "route-first.line.1",
          "who": "me",
          "text": "Martin. Give me the next room."
        },
        {
          "id": "route-first.line.2",
          "who": "radio",
          "text": "{TARGET}. {FLOOR}. Use {LANDMARK}."
        },
        {
          "id": "route-first.line.3",
          "who": "radio",
          "text": "Mark that before you put the set away. If you call from the next landing, I can narrow it down."
        }
      ]
    },
    "route-repeat": {
      "id": "route-repeat",
      "type": "dialogue",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / route desk",
        "status": "LIVE"
      },
      "lines": [
        {
          "id": "route-repeat.line.1",
          "who": "me",
          "text": "Route check. Still heading for {TARGET}."
        },
        {
          "id": "route-repeat.line.2",
          "who": "radio",
          "text": "{ROUTEREPEAT}"
        },
        {
          "id": "route-repeat.line.3",
          "who": "radio",
          "text": "I've still got your place on the sheet."
        }
      ]
    },
    "route-unresolved": {
      "id": "route-unresolved",
      "type": "dialogue",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / paper plan",
        "status": "UNRESOLVED"
      },
      "lines": [
        {
          "id": "route-unresolved.line.1",
          "who": "me",
          "text": "Martin, I need a route."
        },
        {
          "id": "route-unresolved.line.2",
          "who": "radio",
          "text": "I can't place that on this plan. Find a signed landing and read me the number. I'll wait."
        }
      ]
    },
    "hush-near": {
      "id": "hush-near",
      "type": "dialogue",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / front desk relay",
        "status": "LIVE"
      },
      "lines": [
        {
          "id": "hush-near.line.1",
          "who": "me",
          "text": "Martin. There's something in this room. I can feel it moving."
        },
        {
          "id": "hush-near.line.2",
          "who": "radio",
          "text": "Can you get back to the door you came through? Do that first. Take your thumb off the key while you move."
        },
        {
          "id": "hush-near.line.3",
          "who": "radio",
          "text": "Find the landing sign. Give me its number and I'll find you."
        }
      ]
    },
    "post-contact": {
      "id": "post-contact",
      "type": "dialogue",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / front desk relay",
        "status": "LIVE"
      },
      "lines": [
        {
          "id": "post-contact.line.1",
          "who": "me",
          "text": "Martin. Something just hit me. I didn't see it properly."
        },
        {
          "id": "post-contact.line.2",
          "who": "radio",
          "text": "Are you hurt? Can you walk? Get clear of that doorway if you can."
        },
        {
          "id": "post-contact.line.3",
          "who": "radio",
          "text": "Find a landing you can name. Call me from there; I'm staying at the set."
        }
      ]
    }
  }
