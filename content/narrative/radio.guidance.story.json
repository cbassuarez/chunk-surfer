    "request": {
      "id": "request",
      "type": "choice",
      "lines": [
        {
          "id": "request.line.front",
          "who": "direction",
          "text": "Channel two. Your thumb rests beside transmit."
        }
      ],
      "choices": [
        {
          "id": "request.choice.directions",
          "text": "Ask Martin for a route",
          "goto": "directions"
        },
        {
          "id": "request.choice.help",
          "text": "Call for help",
          "goto": "help"
        },
        {
          "id": "request.choice.lower",
          "text": "Lower the set",
          "goto": "lower"
        }
      ]
    },
    "take-running": {
      "id": "take-running",
      "type": "choice",
      "lines": [
        {
          "id": "take-running.line.recorder",
          "who": "direction",
          "text": "Transmitting will stop the recorder's take or listening check."
        }
      ],
      "choices": [
        {
          "id": "take-running.choice.stop-call",
          "text": "Stop the recorder and call",
          "goto": "stop-call"
        },
        {
          "id": "take-running.choice.lower",
          "text": "Keep the recorder running",
          "goto": "lower"
        }
      ]
    },
