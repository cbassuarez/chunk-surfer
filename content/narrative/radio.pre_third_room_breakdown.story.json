        "inbound",
        "start"
      ]
    },
    {
      "id": "radio.pre_third_room_breakdown.responses",
      "title": "The route check",
      "kind": "branch",
      "color": "#2f6f64",
      "nodeIds": [
        "normal",
        "room",
        "listen"
      ]
    },
    {
      "id": "radio.pre_third_room_breakdown.contact",
      "title": "The hand and the contact",
      "kind": "branch",
      "color": "#6a3943",
      "nodeIds": [
        "relay",
        "contact",
        "reseat",
