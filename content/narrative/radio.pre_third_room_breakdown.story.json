      ]
    }
  ],
  "nodes": {
    "manual": {
      "id": "manual",
      "type": "dialogue",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / outgoing call",
        "status": "CALLING"
      },
      "lines": [
        {
          "id": "manual.line.call",
          "who": "me",
          "text": "Martin, route check. I'm near {ROOMLABEL}."
        },
        {
          "id": "manual.line.desk",
          "who": "radio",
          "text": "Got you. Stay there a moment; I've got the wrong sheet on top."
        }
      ],
      "goto": "start"
    },
    "inbound": {
      "id": "inbound",
      "type": "dialogue",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / incoming call",
        "status": "CALLING"
      },
      "lines": [
        {
          "id": "inbound.line.call",
          "who": "radio",
          "text": "4417-C? Martin. Before you go through to {ROOMLABEL}—"
        },
        {
          "id": "inbound.line.desk",
          "who": "radio",
          "text": "Stay there a moment; I've got the wrong sheet on top."
        }
      ],
      "goto": "start"
    },
    "start": {
      "id": "start",
      "type": "choice",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / front desk relay",
        "status": "LIVE"
      },
      "lines": [
        {
          "id": "rupture.onset",
          "who": "direction",
          "text": "Paper slides over Martin's desk. His pencil taps twice. The handset settles close to your ear."
        }
      ],
      "choices": [
        {
          "id": "start.choice.1",
          "text": "Yeah. Receiving.",
          "goto": "normal"
        },
        {
          "id": "start.choice.2",
          "text": "Which room have you got?",
          "goto": "room"
        },
        {
          "id": "start.choice.3",
          "text": "Keep your thumb off transmit.",
          "goto": "listen"
        }
      ]
    },
    "normal": {
      "id": "normal",
      "type": "dialogue",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / front desk relay",
        "status": "LIVE"
      },
      "lines": [
        {
          "id": "normal.line.reply",
          "who": "me",
          "text": "Yeah. Receiving."
        },
        {
          "id": "normal.line.route",
          "who": "radio",
          "text": "{ROOMLABEL}. Yes, I've got you now. Hold on."
        }
      ],
      "goto": "relay"
    },
    "room": {
      "id": "room",
      "type": "dialogue",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / front desk relay",
        "status": "LIVE"
      },
      "lines": [
        {
          "id": "room.line.reply",
          "who": "me",
          "text": "Which room have you got?"
        },
        {
          "id": "room.line.route",
          "who": "radio",
          "text": "{ROOMLABEL}. The doorway should be in front of you. Let me check the—"
        }
      ],
      "goto": "relay"
    },
    "listen": {
      "id": "listen",
      "type": "dialogue",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / front desk relay",
        "status": "LIVE"
      },
      "lines": [
        {
          "id": "listen.line.hand",
          "who": "direction",
          "text": "You keep your thumb beside the key."
        },
        {
          "id": "listen.line.route",
          "who": "radio",
          "text": "There you are. {ROOMLABEL}. Hold on."
        }
      ],
      "goto": "relay"
    },
    "relay": {
      "id": "relay",
      "type": "dialogue",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / transmit held",
        "status": "CARRIER"
      },
      "lines": [
        {
          "id": "rupture.relay",
          "who": "direction",
          "text": "The room ahead gives back the scrape of Martin's chair. Then the same scrape reaches the speaker, small and dry."
        },
        {
          "id": "relay.line.2",
          "who": "radio",
          "text": "Wait. I haven't moved."
        },
        {
          "id": "relay.line.3",
          "who": "direction",
          "text": "The transmit key sinks under your thumb. You lift your thumb; the key stays down."
        }
      ],
      "goto": "contact"
    },
    "contact": {
      "id": "contact",
      "type": "choice",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / loose contact",
        "status": "CARRIER"
      },
      "lines": [
        {
          "id": "contact.line.seam",
          "who": "direction",
          "text": "The battery plate has lifted at one corner. The speaker keeps drawing breath through it."
        },
        {
          "id": "rupture.decision",
          "who": "you",
          "text": "I could seat the battery. Might get Martin back. But if the channel opens, this room will hear me."
        }
      ],
      "choices": [
        {
          "id": "contact.choice.reseat",
          "text": "Seat the battery — risk the carrier",
          "goto": "reseat",
          "mutations": {
            "set": [
              "radio.contact.reseated"
            ],
            "clear": [
              "radio.contact.held"
            ]
          }
        },
        {
          "id": "contact.choice.still",
          "text": "Keep it still — let the channel go",
          "goto": "still",
          "mutations": {
            "set": [
              "radio.contact.held"
            ],
            "clear": [
              "radio.contact.reseated"
            ]
          }
        }
      ]
    },
    "reseat": {
      "id": "reseat",
      "type": "dialogue",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / contact seated",
        "status": "CARRIER"
      },
      "lines": [
        {
          "id": "rupture.reseat",
          "who": "direction",
          "text": "You press the battery home with the heel of your hand. The lamp catches. Your intake of breath comes out of the speaker."
        },
        {
          "id": "reseat.line.answer",
          "who": "direction",
          "text": "It continues from the room after you stop breathing in."
        }
      ],
      "goto": "break"
    },
    "still": {
      "id": "still",
      "type": "dialogue",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / contact held",
        "status": "CARRIER"
      },
      "lines": [
        {
          "id": "rupture.still",
          "who": "direction",
          "text": "You hold the loose plate against your palm without pushing it home. The lamp weakens. You wait with your thumb clear of the key."
        }
      ],
      "goto": "break"
    },
    "break": {
      "id": "break",
      "type": "dialogue",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / carrier lost",
        "status": "DEAD"
      },
      "lines": [
        {
          "id": "rupture.break",
          "who": "direction",
          "text": "The speaker cone pulls hard against its frame. One contact cracks. The lamp goes out."
        }
      ],
      "goto": "after"
    },
    "after": {
      "id": "after",
      "type": "dialogue",
      "art": {
        "id": "walkie",
        "mode": "hero",
        "caption": "Field radio / no carrier",
        "status": "DEAD"
      },
      "lines": [
        {
          "id": "rupture.after",
          "who": "direction",
          "text": "The dead set hangs from its strap. Your thumb stays bent above it."
        }
      ]
    }
  }
}
