        {
          "id": "nodes.last-choice.c1",
          "text": "The way it lets go.",
          "source": "src/data/source-rest-couperin-conversation.js:206",
          "choiceId": "release",
          "goto": "nodes.letting-go"
        }
      ],
      "source": "src/data/source-rest-couperin-conversation.js:205"
    },
    "nodes.beginning": {
      "id": "nodes.beginning",
      "type": "line",
      "lines": [
        {
          "id": "nodes.beginning.l0",
          "who": "you",
          "text": "The way it begins.",
          "source": "src/data/source-rest-couperin-conversation.js:208"
        },
        {
          "id": "nodes.beginning.l1",
          "who": "other",
          "text": "All right.",
          "source": "src/data/source-rest-couperin-conversation.js:209"
        },
        {
          "id": "nodes.beginning.l2",
          "who": "you",
          "text": "I think that is what I was after.",
          "source": "src/data/source-rest-couperin-conversation.js:210"
        },
        {
          "id": "nodes.beginning.l3",
          "who": "other",
          "text": "Go on.",
          "source": "src/data/source-rest-couperin-conversation.js:211"
        },
        {
          "id": "nodes.beginning.l4",
          "who": "you",
          "text": "No. Listen.",
          "source": "src/data/source-rest-couperin-conversation.js:212"
        },
        {
          "id": "nodes.beginning.l5",
          "who": "other",
          "text": "I am listening.",
          "source": "src/data/source-rest-couperin-conversation.js:213"
        }
      ],
      "source": "src/data/source-rest-couperin-conversation.js:208",
      "goto": "nodes.last"
    },
    "nodes.letting-go": {
      "id": "nodes.letting-go",
      "type": "line",
      "lines": [
        {
          "id": "nodes.letting-go.l0",
          "who": "you",
          "text": "The way it lets go.",
          "source": "src/data/source-rest-couperin-conversation.js:216"
        },
        {
          "id": "nodes.letting-go.l1",
          "who": "other",
          "text": "All right.",
          "source": "src/data/source-rest-couperin-conversation.js:217"
        },
        {
          "id": "nodes.letting-go.l2",
          "who": "you",
          "text": "It does not have to be much.",
          "source": "src/data/source-rest-couperin-conversation.js:218"
        },
        {
          "id": "nodes.letting-go.l3",
          "who": "other",
          "text": "No.",
          "source": "src/data/source-rest-couperin-conversation.js:219"
        },
        {
          "id": "nodes.letting-go.l4",
          "who": "you",
          "text": "A little more room, perhaps.",
          "source": "src/data/source-rest-couperin-conversation.js:220"
        },
        {
          "id": "nodes.letting-go.l5",
          "who": "other",
          "text": "Here.",
          "source": "src/data/source-rest-couperin-conversation.js:221"
        }
      ],
      "source": "src/data/source-rest-couperin-conversation.js:216",
      "goto": "nodes.last"
    },
    "nodes.last": {
      "id": "nodes.last",
      "type": "line",
      "lines": [
        {
          "id": "nodes.last.l0",
          "who": "you",
          "text": "I cannot tell where the edge of it is.",
          "source": "src/data/source-rest-couperin-conversation.js:224"
        },
        {
          "id": "nodes.last.l1",
          "who": "other",
          "text": "The note?",
          "source": "src/data/source-rest-couperin-conversation.js:225"
        },
        {
          "id": "nodes.last.l2",
          "who": "you",
          "text": "The room.",
          "source": "src/data/source-rest-couperin-conversation.js:226"
        },
        {
          "id": "nodes.last.l3",
          "who": "other",
          "text": "Leave the room a moment.",
          "source": "src/data/source-rest-couperin-conversation.js:227"
        },
        {
          "id": "nodes.last.l4",
          "who": "you",
          "text": "Will I still know when it ends?",
          "source": "src/data/source-rest-couperin-conversation.js:228"
        },
        {
          "id": "nodes.last.l5",
          "who": "other",
          "text": "We can listen for the space after it.",
          "source": "src/data/source-rest-couperin-conversation.js:229"
        },
        {
          "id": "nodes.last.l6",
          "who": "you",
          "text": "Do not count.",
          "source": "src/data/source-rest-couperin-conversation.js:230"
        },
        {
          "id": "nodes.last.l7",
          "who": "other",
          "text": "No.",
          "source": "src/data/source-rest-couperin-conversation.js:231"
        },
        {
          "id": "nodes.last.l8",
          "who": "you",
          "text": "There it is.",
          "source": "src/data/source-rest-couperin-conversation.js:232"
        },
        {
          "id": "nodes.last.l9",
          "who": "other",
          "text": "Yes.",
          "source": "src/data/source-rest-couperin-conversation.js:233"
        },
        {
          "id": "nodes.last.l10",
          "who": "you",
          "text": "Leave it there.",
          "source": "src/data/source-rest-couperin-conversation.js:234"
        }
