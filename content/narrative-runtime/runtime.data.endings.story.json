    "ENDING_MANIFEST.sacrifice.objective.timeline": {
      "id": "ENDING_MANIFEST.sacrifice.objective.timeline",
      "type": "line",
      "lines": [
        {
          "id": "ENDING_MANIFEST.sacrifice.objective.timeline.l0",
          "who": "you",
          "text": "Every light behind me has just gone.",
          "source": "src/data/endings.js:346"
        },
        {
          "id": "ENDING_MANIFEST.sacrifice.objective.timeline.l1",
          "who": "direction",
          "text": "The corridor you came down is not dark. It is closed, which is a different thing, and you can hear the difference.",
          "source": "src/data/endings.js:348"
        },
        {
          "id": "ENDING_MANIFEST.sacrifice.objective.timeline.l2",
          "who": "you",
          "text": "It is not chasing me. It is just shutting doors.",
          "source": "src/data/endings.js:350"
        }
      ],
      "source": "src/data/endings.js:346"
    },
    "ENDING_MANIFEST.helped.objective.timeline": {
      "id": "ENDING_MANIFEST.helped.objective.timeline",
      "type": "line",
      "lines": [
        {
          "id": "ENDING_MANIFEST.helped.objective.timeline.l0",
          "who": "you",
          "text": "The taste is still there. Eight hours and it is still there.",
          "source": "src/data/endings.js:391"
        },
        {
          "id": "ENDING_MANIFEST.helped.objective.timeline.l1",
          "who": "you",
          "text": "He is still on that gate. He will still be on it at six.",
          "source": "src/data/endings.js:393"
        }
      ],
      "source": "src/data/endings.js:391"
    },
    "ENDING_MANIFEST.inversion.objective.timeline": {
