    "ENDING_MANIFEST.surfaced.objective.timeline": {
      "id": "ENDING_MANIFEST.surfaced.objective.timeline",
      "type": "line",
      "lines": [
        {
          "id": "ENDING_MANIFEST.surfaced.objective.timeline.l0",
          "who": "recordist",
          "text": "Left at the end. Not the stairs. I know what the stairs are for.",
          "source": "src/data/endings.js:525"
        },
        {
          "id": "ENDING_MANIFEST.surfaced.objective.timeline.l1",
          "who": "recordist",
          "text": "You can put me down. I am saying that for you, not for me. I would rather you did not.",
          "source": "src/data/endings.js:526"
        },
        {
          "id": "ENDING_MANIFEST.surfaced.objective.timeline.l2",
          "who": "recordist",
          "text": "It has stopped asking. Do you hear that? It has been asking for eleven weeks and it has stopped.",
          "source": "src/data/endings.js:527"
        },
        {
          "id": "ENDING_MANIFEST.surfaced.objective.timeline.l3",
          "who": "you",
          "text": "Keep talking. Whatever you have got. Just keep talking.",
          "source": "src/data/endings.js:528"
        },
        {
          "id": "ENDING_MANIFEST.surfaced.objective.timeline.l4",
          "who": "recordist",
          "text": "Take one. Room tone, studio B3, and a man breathing who is not going to be here in the morning. That was mine. That was my slate.",
          "source": "src/data/endings.js:529"
        }
      ],
      "source": "src/data/endings.js:525"
    }
  }
