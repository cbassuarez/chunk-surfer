      "type": "line",
      "lines": [
        {
          "id": "vigilBelfryRecognition.l0",
          "who": "you",
          "text": "His pencil line. Chapel to chapel. I had been standing at the other end.",
          "source": "src/data/exterior-vigil.js:402"
        }
      ],
      "source": "src/data/exterior-vigil.js:402"
    },
    "vigilConversation": {
      "id": "vigilConversation",
      "type": "line",
      "lines": [
        {
          "id": "vigilConversation.l0",
          "who": "direction",
          "text": "Her thumb returns to the rota. The column after six is headed LESSONS / RESTART.",
          "source": "src/data/exterior-vigil.js:436"
        },
        {
          "id": "vigilConversation.l1",
          "who": "direction",
          "text": "There it is: a timetable with room for everything except an answer that stays no. I can hear it in hers more easily than in my own.",
          "source": "src/data/exterior-vigil.js:452"
        },
        {
          "id": "vigilConversation.l2",
          "who": "direction",
          "text": "She aligns the sleeves. The empty room is something she can keep. An occupied one might refuse the photograph.",
          "source": "src/data/exterior-vigil.js:473"
        }
      ],
      "source": "src/data/exterior-vigil.js:436"
