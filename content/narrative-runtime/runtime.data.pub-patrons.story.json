  "notes": "Generated from src/data/pub-patrons.js by scripts/export-runtime-narrative.mjs. Read-only: the game reads the module, not this document. Edit the module (or move the dialogue into content/narrative) and relaunch the studio.",
  "nodes": {
    "people.mavis": {
      "id": "people.mavis",
      "type": "line",
      "lines": [
        {
          "id": "people.mavis.l0",
          "who": "inspect",
          "text": "They have taken our stop off the board. Ed says that means we can stop waiting. I say they could have told the bus.",
          "source": "src/data/pub-patrons.js:7"
        },
        {
          "id": "people.mavis.l1",
          "who": "inspect",
          "text": "(again) Still no bus. Considerably better seating.",
          "source": "src/data/pub-patrons.js:7"
        }
      ],
      "source": "src/data/pub-patrons.js:7"
    },
    "people.ed": {
      "id": "people.ed",
      "type": "line",
      "lines": [
        {
          "id": "people.ed.l0",
          "who": "inspect",
          "text": "Mind that chair. One short leg. Mavis has a folded timetable under it and will have to catch the bus standing up.",
          "source": "src/data/pub-patrons.js:10"
        },
        {
          "id": "people.ed.l1",
          "who": "inspect",
          "text": "(again) She has put another timetable under it. Service is improving.",
          "source": "src/data/pub-patrons.js:10"
        }
      ],
      "source": "src/data/pub-patrons.js:10"
    },
    "people.bert": {
      "id": "people.bert",
      "type": "line",
      "lines": [
        {
          "id": "people.bert.l0",
          "who": "inspect",
          "text": "That is a six. She says it is a five. You look like a man paid to identify a thing without changing it.",
          "source": "src/data/pub-patrons.js:13"
        },
        {
          "id": "people.bert.l1",
          "who": "inspect",
          "text": "(again) We have agreed it is a six. We have not agreed whose six.",
          "source": "src/data/pub-patrons.js:13"
        }
      ],
      "source": "src/data/pub-patrons.js:13"
    },
    "people.farah": {
      "id": "people.farah",
      "type": "line",
      "lines": [
        {
          "id": "people.farah.l0",
          "who": "inspect",
          "text": "Do not adjudicate. He likes an audience more than he likes being right.",
          "source": "src/data/pub-patrons.js:16"
        },
        {
          "id": "people.farah.l1",
          "who": "inspect",
          "text": "(again) He is thinking. We may be here some time.",
          "source": "src/data/pub-patrons.js:16"
        }
      ],
      "source": "src/data/pub-patrons.js:16"
    },
    "people.nell": {
      "id": "people.nell",
      "type": "line",
      "lines": [
        {
          "id": "people.nell.l0",
          "who": "inspect",
          "text": "I have finished work. If you want anything sensible said, try somebody who has slept.",
          "source": "src/data/pub-patrons.js:19"
        },
        {
          "id": "people.nell.l1",
          "who": "inspect",
          "text": "(again) Still off duty. That is not a complaint.",
          "source": "src/data/pub-patrons.js:19"
        }
      ],
      "source": "src/data/pub-patrons.js:19"
    },
    "people.arthur": {
      "id": "people.arthur",
      "type": "line",
      "lines": [
        {
          "id": "people.arthur.l0",
          "who": "inspect",
          "text": "There used to be a piano where that stool is. It had one good note. People were surprisingly inventive with it.",
          "source": "src/data/pub-patrons.js:22"
        },
        {
          "id": "people.arthur.l1",
          "who": "inspect",
          "text": "(again) Same stool. Same missing piano.",
          "source": "src/data/pub-patrons.js:22"
        }
      ],
      "source": "src/data/pub-patrons.js:22"
    },
    "pubPatronConversation.choices": {
      "id": "pubPatronConversation.choices",
      "type": "choice",
      "lines": [],
      "choices": [
        {
          "id": "pubPatronConversation.choices.c0",
          "text": "Leave them to their evening.",
          "source": "src/data/pub-patrons.js:28"
        }
      ],
      "source": "src/data/pub-patrons.js:28"
    },
    "PUB_OVERHEARDS": {
      "id": "PUB_OVERHEARDS",
      "type": "line",
      "lines": [
        {
          "id": "PUB_OVERHEARDS.l0",
          "who": "unknown",
          "text": "Your move.",
          "source": "src/data/pub-patrons.js:37"
        },
        {
          "id": "PUB_OVERHEARDS.l1",
          "who": "unknown",
          "text": "It was my move when you began that story.",
          "source": "src/data/pub-patrons.js:37"
        },
        {
          "id": "PUB_OVERHEARDS.l2",
          "who": "unknown",
          "text": "They used to wait for the violin cases.",
          "source": "src/data/pub-patrons.js:38"
        },
        {
          "id": "PUB_OVERHEARDS.l3",
          "who": "unknown",
          "text": "You have said.",
          "source": "src/data/pub-patrons.js:38"
        },
        {
          "id": "PUB_OVERHEARDS.l4",
          "who": "unknown",
          "text": "Somebody ought to.",
          "source": "src/data/pub-patrons.js:38"
        },
        {
          "id": "PUB_OVERHEARDS.l5",
          "who": "unknown",
          "text": "That is the bells.",
          "source": "src/data/pub-patrons.js:39"
        },
        {
          "id": "PUB_OVERHEARDS.l6",
          "who": "unknown",
          "text": "I know.",
          "source": "src/data/pub-patrons.js:39"
        },
        {
          "id": "PUB_OVERHEARDS.l7",
          "who": "unknown",
          "text": "Whose coat is on the spare chair?",
          "source": "src/data/pub-patrons.js:40"
        },
        {
          "id": "PUB_OVERHEARDS.l8",
          "who": "unknown",
          "text": "It is a spare coat. Leave it somewhere to sit.",
          "source": "src/data/pub-patrons.js:40"
        },
        {
          "id": "PUB_OVERHEARDS.l9",
          "who": "unknown",
          "text": "There is soup if you are staying.",
          "source": "src/data/pub-patrons.js:41"
        },
        {
          "id": "PUB_OVERHEARDS.l10",
          "who": "unknown",
          "text": "It would be a shame to disappoint the soup.",
          "source": "src/data/pub-patrons.js:41"
        },
        {
          "id": "PUB_OVERHEARDS.l11",
          "who": "unknown",
          "text": "Take your scarf off before you roast.",
          "source": "src/data/pub-patrons.js:42"
        },
        {
          "id": "PUB_OVERHEARDS.l12",
          "who": "unknown",
          "text": "I am only just getting the street out of it.",
          "source": "src/data/pub-patrons.js:42"
        },
        {
          "id": "PUB_OVERHEARDS.l13",
          "who": "unknown",
          "text": "Leave him the heel. He likes the heel.",
          "source": "src/data/pub-patrons.js:43"
        },
        {
          "id": "PUB_OVERHEARDS.l14",
          "who": "unknown",
          "text": "Only when everybody else wants it.",
          "source": "src/data/pub-patrons.js:43"
        },
        {
          "id": "PUB_OVERHEARDS.l15",
          "who": "unknown",
          "text": "Tea for the ones at the rail?",
          "source": "src/data/pub-patrons.js:44"
        },
        {
          "id": "PUB_OVERHEARDS.l16",
          "who": "unknown",
          "text": "On the tray. There is a clean towel under it.",
          "source": "src/data/pub-patrons.js:44"
        },
        {
          "id": "PUB_OVERHEARDS.l17",
          "who": "unknown",
          "text": "Who has been warming my gloves?",
          "source": "src/data/pub-patrons.js:45"
        },
        {
          "id": "PUB_OVERHEARDS.l18",
          "who": "unknown",
          "text": "They were nearest the stove. We had to put something on the chair.",
          "source": "src/data/pub-patrons.js:45"
        }
      ],
      "source": "src/data/pub-patrons.js:37"
    }
  }
}
