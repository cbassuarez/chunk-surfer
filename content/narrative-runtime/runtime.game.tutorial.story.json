      "lines": [
        {
          "id": "STEPS.read.line.l0",
          "who": "you",
          "text": "Work order's in my jacket. Five rooms, one clean minute each.",
          "source": "src/game/tutorial.js:64"
        }
      ],
      "source": "src/game/tutorial.js:64"
    },
    "STEPS.level.line": {
      "id": "STEPS.level.line",
      "type": "line",
      "lines": [
        {
          "id": "STEPS.level.line.l0",
          "who": "you",
          "text": "Levels, before anything. Headphones on, hear the room — then roll, and hold still.",
          "source": "src/game/tutorial.js:88"
        }
      ],
      "source": "src/game/tutorial.js:88"
    },
    "STEPS.mark.line": {
      "id": "STEPS.mark.line",
      "type": "line",
      "lines": [
        {
          "id": "STEPS.mark.line.l0",
          "who": "you",
          "text": "Right. Before I go anywhere — write down where I am going.",
          "source": "src/game/tutorial.js:104"
        }
      ],
      "source": "src/game/tutorial.js:104"
    },
    "STEPS.mark.exit": {
      "id": "STEPS.mark.exit",
      "type": "line",
      "lines": [
        {
          "id": "STEPS.mark.exit.l0",
          "who": "you",
          "text": "Down the west stair, behind the dock. Mark them off as you go and you never lose an hour.",
          "source": "src/game/tutorial.js:109"
        }
      ],
      "source": "src/game/tutorial.js:109"
    },
    "STEPS.go.line": {
      "id": "STEPS.go.line",
      "type": "line",
      "lines": [
        {
          "id": "STEPS.go.line.l0",
          "who": "you",
          "text": "Inner door, south end. Down to B3 — follow the bearing. That mark is the whole point of making it.",
          "source": "src/game/tutorial.js:122"
        }
      ],
      "source": "src/game/tutorial.js:122"
    },
