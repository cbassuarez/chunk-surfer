      "type": "line",
      "lines": [
        {
          "id": "STEPS.go.exit.l0",
          "who": "you",
          "text": "Quietly, then. Everything I do in here, the building keeps.",
          "source": "src/game/tutorial.js:129"
        }
      ],
      "source": "src/game/tutorial.js:129"
    },
