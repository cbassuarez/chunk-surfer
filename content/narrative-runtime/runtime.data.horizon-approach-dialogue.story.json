      "lines": [
        {
          "id": "horizonApproachTruth.l0",
          "who": "you",
          "text": "The boundary was mine.",
          "source": "src/data/horizon-approach-dialogue.js:12"
        },
        {
          "id": "horizonApproachTruth.l1",
          "who": "you",
          "text": "You could leave that part to me. / I never said you could.",
          "source": "src/data/horizon-approach-dialogue.js:13"
        },
        {
          "id": "horizonApproachTruth.l2",
          "who": "you",
          "text": "The spring gives out in the seventh bar. / You brought the one from the cab. / The part that would not play.",
          "source": "src/data/horizon-approach-dialogue.js:16"
        },
        {
          "id": "horizonApproachTruth.l3",
          "who": "you",
          "text": "It never worked. That was all right.",
          "source": "src/data/horizon-approach-dialogue.js:17"
        },
        {
          "id": "horizonApproachTruth.l4",
          "who": "you",
          "text": "I can finish it.",
          "source": "src/data/horizon-approach-dialogue.js:18"
        },
        {
          "id": "horizonApproachTruth.l5",
          "who": "you",
          "text": "It gets across.",
          "source": "src/data/horizon-approach-dialogue.js:20"
        },
        {
          "id": "horizonApproachTruth.l6",
          "who": "you",
          "text": "Twenty-one petals.",
