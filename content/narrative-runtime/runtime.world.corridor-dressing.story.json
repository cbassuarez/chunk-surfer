          "text": "{space.label}, stencilled on the plate beside the opening.",
          "source": "src/world/corridor-dressing.js:391"
        },
        {
          "id": "doorPlates.plate-door.id-.inspect.l1",
          "who": "inspect",
          "text": "(again) {space.shortLabel || space.label}. Still where the plan says it is.",
          "source": "src/world/corridor-dressing.js:391"
        }
      ],
      "source": "src/world/corridor-dressing.js:391"
    },
    "FLIGHT_DRESSING.main-basement-stair-west-flight": {
      "id": "FLIGHT_DRESSING.main-basement-stair-west-flight",
      "type": "line",
      "lines": [
        {
          "id": "FLIGHT_DRESSING.main-basement-stair-west-flight.l0",
          "who": "inspect",
          "text": "Steel handrails down both sides of the flight, and the treads under them worn pale in the middle.",
          "source": "src/world/corridor-dressing.js:506"
        },
        {
          "id": "FLIGHT_DRESSING.main-basement-stair-west-flight.l1",
          "who": "inspect",
          "text": "(again) Twenty rises. The wear says most people took them two at a time.",
          "source": "src/world/corridor-dressing.js:506"
        }
      ],
      "source": "src/world/corridor-dressing.js:506"
    }
  }
