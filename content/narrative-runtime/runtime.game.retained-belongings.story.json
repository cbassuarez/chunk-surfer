        {
          "id": "RETAINED_BELONGINGS.b3-session-card.l0",
          "who": "direction",
          "text": "A session card on the console. One: voice. Two: room. Three has been carefully crossed out, but its fader is still set.",
          "source": "src/game/retained-belongings.js:12"
        },
        {
          "id": "RETAINED_BELONGINGS.b3-session-card.l1",
          "who": "direction",
          "text": "In the margin, two chairs and fine lines to the glass.",
          "source": "src/game/retained-belongings.js:13"
        }
      ],
      "source": "src/game/retained-belongings.js:12"
    },
    "RETAINED_BELONGINGS.b3-session-card.inspectionActions.read-channels": {
      "id": "RETAINED_BELONGINGS.b3-session-card.inspectionActions.read-channels",
