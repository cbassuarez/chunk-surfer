      "lines": [
        {
          "id": "RETAINED_BELONGINGS.lyle-music-box.inspectionActions.remember-gift.l0",
          "who": "you",
          "text": "Lyle gave me this before his big break. So I’d have something to remember him by.",
          "source": "src/game/retained-belongings.js:43"
        },
        {
          "id": "RETAINED_BELONGINGS.lyle-music-box.inspectionActions.remember-gift.l1",
