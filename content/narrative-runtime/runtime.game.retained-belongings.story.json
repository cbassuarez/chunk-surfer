        },
        {
          "id": "RETAINED_BELONGINGS.b3-session-card.inspectionActions.read-channels.l1",
          "who": "you",
          "text": "The crossing-out is on the card. Its fader was still set when I picked it up.",
          "source": "src/game/retained-belongings.js:16"
        }
      ],
      "source": "src/game/retained-belongings.js:16"
