    "RETAINED_BELONGINGS.vale-guarantor-slip": {
      "id": "RETAINED_BELONGINGS.vale-guarantor-slip",
      "type": "line",
      "lines": [
        {
          "id": "RETAINED_BELONGINGS.vale-guarantor-slip.l0",
          "who": "direction",
          "text": "A narrow maintenance slip is folded beneath the chamber piano bench. It was kept under the seat rather than filed with the school accounts.",
          "source": "src/game/retained-belongings.js:24"
        },
        {
          "id": "RETAINED_BELONGINGS.vale-guarantor-slip.l1",
          "who": "direction",
          "text": "The dates are separated by decades. The handwriting belongs to the same person throughout.",
          "source": "src/game/retained-belongings.js:25"
        }
      ],
      "source": "src/game/retained-belongings.js:24"
    },
    "RETAINED_BELONGINGS.vale-guarantor-slip.inspectionActions.year-zero": {
      "id": "RETAINED_BELONGINGS.vale-guarantor-slip.inspectionActions.year-zero",
      "type": "line",
      "lines": [
        {
          "id": "RETAINED_BELONGINGS.vale-guarantor-slip.inspectionActions.year-zero.l0",
          "who": "direction",
          "text": "SEAL, YEAR 0. M. VALE, CLEANER. I have been told that I will stay inside the grounds for one hundred years. I am signing while I can still walk away.",
          "source": "src/game/retained-belongings.js:28"
        }
      ],
      "source": "src/game/retained-belongings.js:28"
    },
    "RETAINED_BELONGINGS.vale-guarantor-slip.inspectionActions.year-twelve": {
      "id": "RETAINED_BELONGINGS.vale-guarantor-slip.inspectionActions.year-twelve",
      "type": "line",
      "lines": [
        {
          "id": "RETAINED_BELONGINGS.vale-guarantor-slip.inspectionActions.year-twelve.l0",
          "who": "direction",
          "text": "YEAR 12. My daughter married on Saturday. Ren brought the photograph on Monday. I knew I would miss the day. I did not know how much of it would fit in one picture.",
          "source": "src/game/retained-belongings.js:29"
        }
      ],
      "source": "src/game/retained-belongings.js:29"
    },
    "RETAINED_BELONGINGS.vale-guarantor-slip.inspectionActions.year-sixty-one": {
      "id": "RETAINED_BELONGINGS.vale-guarantor-slip.inspectionActions.year-sixty-one",
      "type": "line",
      "lines": [
        {
          "id": "RETAINED_BELONGINGS.vale-guarantor-slip.inspectionActions.year-sixty-one.l0",
          "who": "direction",
          "text": "YEAR 61. The chamber roof leaked again. I changed the bucket before class. The seal kept the crews from taking the room. It never mended it for us.",
          "source": "src/game/retained-belongings.js:30"
        }
      ],
      "source": "src/game/retained-belongings.js:30"
    },
    "RETAINED_BELONGINGS.lyle-music-box": {
      "id": "RETAINED_BELONGINGS.lyle-music-box",
      "type": "line",
      "lines": [
        {
          "id": "RETAINED_BELONGINGS.lyle-music-box.l0",
          "who": "direction",
          "text": "The music box is broken now. It is still the one Lyle gave you.",
          "source": "src/game/retained-belongings.js:37"
        },
        {
          "id": "RETAINED_BELONGINGS.lyle-music-box.l1",
          "who": "you",
          "text": "Lyle gave me this before his big break. So I’d have something to remember him by.",
          "source": "src/game/retained-belongings.js:38"
        }
      ],
      "source": "src/game/retained-belongings.js:37"
    },
    "RETAINED_BELONGINGS.lyle-music-box.inspectionActions.handle-box": {
      "id": "RETAINED_BELONGINGS.lyle-music-box.inspectionActions.handle-box",
      "type": "line",
      "lines": [
        {
          "id": "RETAINED_BELONGINGS.lyle-music-box.inspectionActions.handle-box.l0",
          "who": "direction",
          "text": "The case stays closed. The oval winding key belongs to the same small object as the cream shell and dark rear plate.",
          "source": "src/game/retained-belongings.js:42"
        }
      ],
      "source": "src/game/retained-belongings.js:42"
    },
