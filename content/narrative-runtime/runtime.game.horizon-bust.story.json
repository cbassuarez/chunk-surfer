  "module": "src/game/horizon-bust.js",
  "notes": "Generated from src/game/horizon-bust.js by scripts/export-runtime-narrative.mjs. Read-only: the game reads the module, not this document. Edit the module (or move the dialogue into content/narrative) and relaunch the studio.",
  "nodes": {
    "SHARED_AUDIENCE": {
      "id": "SHARED_AUDIENCE",
      "type": "line",
      "lines": [
        {
          "id": "SHARED_AUDIENCE.l0",
          "who": "bust",
          "text": "Bold choice. You made it this far, but have left so much behind. I have been expecting you, however.",
          "source": "src/game/horizon-bust.js:10"
        },
        {
          "id": "SHARED_AUDIENCE.l1",
          "who": "you",
          "text": "What choice do I have?",
          "source": "src/game/horizon-bust.js:11"
        },
        {
          "id": "SHARED_AUDIENCE.l2",
          "who": "bust",
          "text": "You can keep walking to the chapel without my help. Beyond me lies the end.",
          "source": "src/game/horizon-bust.js:12"
        },
        {
          "id": "SHARED_AUDIENCE.l3",
          "who": "you",
          "text": "Of?",
          "source": "src/game/horizon-bust.js:13"
        },
        {
          "id": "SHARED_AUDIENCE.l4",
          "who": "bust",
          "text": "Of the road's career as a road. Those lamps and telephone boxes are turning back into their recording. What's gone stays gone. The ground stays under your feet; take your time. Rather bad for property values. Though I do have another way.",
          "source": "src/game/horizon-bust.js:14"
        }
      ],
      "source": "src/game/horizon-bust.js:10"
    },
    "HORIZON_BUST_AUDIENCE.carried": {
      "id": "HORIZON_BUST_AUDIENCE.carried",
      "type": "line",
      "lines": [
        {
          "id": "HORIZON_BUST_AUDIENCE.carried.l0",
          "who": "direction",
          "text": "Inside your bag, the loose marble eyes knock once against your torch and other belongings; not so nice for a pair of eyes. The bust is blind, but it has ears, and he chimes:",
          "source": "src/game/horizon-bust.js:19"
        },
        {
          "id": "HORIZON_BUST_AUDIENCE.carried.l1",
          "who": "bust",
          "text": "Ah, a man of true regard.",
          "source": "src/game/horizon-bust.js:20"
        }
      ],
      "source": "src/game/horizon-bust.js:19"
    },
    "HORIZON_BUST_AUDIENCE.returned": {
      "id": "HORIZON_BUST_AUDIENCE.returned",
      "type": "line",
      "lines": [
        {
          "id": "HORIZON_BUST_AUDIENCE.returned.l0",
          "who": "direction",
          "text": "The eyes you returned are still in the gallery. Here, bronze shutters withdraw from a matching pair of sockets. Mineral pupils settle behind the rims and take the Horizon’s wet colour.",
          "source": "src/game/horizon-bust.js:24"
        },
        {
          "id": "HORIZON_BUST_AUDIENCE.returned.l1",
          "who": "bust",
          "text": "There we are. My. Your eyes—they've seen quite the folly. I have respite for them, a safer path, if you'd like.",
          "source": "src/game/horizon-bust.js:25"
        }
      ],
      "source": "src/game/horizon-bust.js:24"
    },
    "HORIZON_BUST_REFUSAL": {
      "id": "HORIZON_BUST_REFUSAL",
      "type": "line",
      "lines": [
        {
          "id": "HORIZON_BUST_REFUSAL.l0",
          "who": "direction",
          "text": "The bust stays immobile.",
          "source": "src/game/horizon-bust.js:34"
        },
        {
          "id": "HORIZON_BUST_REFUSAL.l1",
          "who": "bust",
          "text": "Do you have eyes for me?",
          "source": "src/game/horizon-bust.js:35"
        }
      ],
      "source": "src/game/horizon-bust.js:34"
    },
    "horizonBustRefusalTree.start": {
      "id": "horizonBustRefusalTree.start",
      "type": "choice",
      "lines": [],
      "choices": [
        {
          "id": "horizonBustRefusalTree.start.c0",
          "text": "Like, do I like you?",
          "source": "src/game/horizon-bust.js:44",
          "goto": "horizonBustRefusalTree.like"
        },
        {
          "id": "horizonBustRefusalTree.start.c1",
          "text": "Yes.",
          "source": "src/game/horizon-bust.js:46",
          "goto": "horizonBustRefusalTree.yes"
        },
        {
          "id": "horizonBustRefusalTree.start.c2",
          "text": "What kind of eyes?",
          "source": "src/game/horizon-bust.js:47",
          "goto": "horizonBustRefusalTree.kind"
        },
        {
          "id": "horizonBustRefusalTree.start.c3",
          "text": "Is that a metaphor?",
          "source": "src/game/horizon-bust.js:48",
          "goto": "horizonBustRefusalTree.metaphor"
        }
      ],
      "source": "src/game/horizon-bust.js:44"
    },
    "horizonBustRefusalTree.like": {
      "id": "horizonBustRefusalTree.like",
      "type": "line",
      "lines": [
        {
          "id": "horizonBustRefusalTree.like.l0",
          "who": "you",
          "text": "Like, do I like you?",
          "source": "src/game/horizon-bust.js:54"
        },
        {
          "id": "horizonBustRefusalTree.like.l1",
          "who": "bust",
          "text": "I'm flattered. Nobody really visits anymore. But no, I mean, do you have eyeballs for me with which to see?",
          "source": "src/game/horizon-bust.js:55"
        },
        {
          "id": "horizonBustRefusalTree.like.l2",
          "who": "you",
          "text": "That... makes more sense, oddly. And no. I don't.",
          "source": "src/game/horizon-bust.js:56"
        }
      ],
      "source": "src/game/horizon-bust.js:54"
    },
    "horizonBustRefusalTree.no": {
      "id": "horizonBustRefusalTree.no",
      "type": "line",
      "lines": [
        {
          "id": "horizonBustRefusalTree.no.l0",
          "who": "bust",
          "text": "That's a shame, I would have made it worth your while.",
          "source": "src/game/horizon-bust.js:64"
        },
        {
          "id": "horizonBustRefusalTree.no.l1",
          "who": "you",
          "text": "In what way?",
          "source": "src/game/horizon-bust.js:65"
        },
        {
          "id": "horizonBustRefusalTree.no.l2",
          "who": "bust",
          "text": "Can't say now.",
          "source": "src/game/horizon-bust.js:66"
        }
      ],
      "source": "src/game/horizon-bust.js:64"
    },
    "horizonBustRefusalTree.yes": {
      "id": "horizonBustRefusalTree.yes",
      "type": "line",
      "lines": [
        {
          "id": "horizonBustRefusalTree.yes.l0",
          "who": "you",
          "text": "Yes.",
          "source": "src/game/horizon-bust.js:73"
        },
        {
          "id": "horizonBustRefusalTree.yes.l1",
          "who": "bust",
          "text": "Wonderful. Put them in.",
          "source": "src/game/horizon-bust.js:74"
        },
        {
          "id": "horizonBustRefusalTree.yes.l2",
          "who": "you",
          "text": "My eyes?",
          "source": "src/game/horizon-bust.js:75"
        },
        {
          "id": "horizonBustRefusalTree.yes.l3",
          "who": "bust",
          "text": "Your spare ones.",
          "source": "src/game/horizon-bust.js:76"
        },
        {
          "id": "horizonBustRefusalTree.yes.l4",
          "who": "you",
          "text": "Right. No yeah, of course.",
          "source": "src/game/horizon-bust.js:77"
        }
      ],
      "source": "src/game/horizon-bust.js:73"
    },
    "horizonBustRefusalTree.kind": {
      "id": "horizonBustRefusalTree.kind",
      "type": "line",
      "lines": [
        {
          "id": "horizonBustRefusalTree.kind.l0",
          "who": "you",
          "text": "What kind of eyes?",
          "source": "src/game/horizon-bust.js:84"
        },
        {
          "id": "horizonBustRefusalTree.kind.l1",
          "who": "bust",
          "text": "Eyeballs. Marble. A pair. Mine, ideally.",
          "source": "src/game/horizon-bust.js:85"
        },
        {
          "id": "horizonBustRefusalTree.kind.l2",
          "who": "you",
          "text": "That... makes more sense, oddly. And no. I don't.",
          "source": "src/game/horizon-bust.js:86"
        }
      ],
      "source": "src/game/horizon-bust.js:84"
    },
    "horizonBustRefusalTree.metaphor": {
      "id": "horizonBustRefusalTree.metaphor",
      "type": "line",
      "lines": [
        {
          "id": "horizonBustRefusalTree.metaphor.l0",
          "who": "you",
          "text": "Is that a metaphor?",
          "source": "src/game/horizon-bust.js:93"
        },
        {
          "id": "horizonBustRefusalTree.metaphor.l1",
          "who": "bust",
          "text": "No. I mean eyeballs with almost offensive literalness.",
          "source": "src/game/horizon-bust.js:94"
        },
        {
          "id": "horizonBustRefusalTree.metaphor.l2",
          "who": "you",
          "text": "Right. No, I don't.",
          "source": "src/game/horizon-bust.js:95"
        }
      ],
      "source": "src/game/horizon-bust.js:93"
    },
    "horizonBustRefusalTree.refused": {
      "id": "horizonBustRefusalTree.refused",
      "type": "choice",
      "lines": [
        {
          "id": "horizonBustRefusalTree.refused.l0",
          "who": "bust",
          "text": "Pity. Then I can't show you the other way.",
          "source": "src/game/horizon-bust.js:102"
        },
        {
          "id": "horizonBustRefusalTree.refused.l1",
          "who": "you",
          "text": "Because you can't see me?",
          "source": "src/game/horizon-bust.js:103"
        },
        {
          "id": "horizonBustRefusalTree.refused.l2",
          "who": "bust",
          "text": "Because that's how deals work lad.",
          "source": "src/game/horizon-bust.js:104"
        }
      ],
      "choices": [
        {
          "id": "horizonBustRefusalTree.refused.c0",
          "text": "Then what CAN you do?",
          "source": "src/game/horizon-bust.js:115",
          "goto": "horizonBustRefusalTree.told"
        }
      ],
      "source": "src/game/horizon-bust.js:102"
    },
    "horizonBustRefusalTree.told": {
      "id": "horizonBustRefusalTree.told",
      "type": "line",
      "lines": [
        {
          "id": "horizonBustRefusalTree.told.l0",
          "who": "you",
          "text": "Then what can you do?",
          "source": "src/game/horizon-bust.js:122"
        },
        {
          "id": "horizonBustRefusalTree.told.l1",
          "who": "bust",
          "text": "Talk. I'm very good at it and there's no queue.",
          "source": "src/game/horizon-bust.js:123"
        },
        {
          "id": "horizonBustRefusalTree.told.l2",
          "who": "bust",
          "text": "The street you came by is turning into its own recording. That was a telephone box a moment ago. Now it's light remembering the shape of one. Very poor weatherproofing.",
          "source": "src/game/horizon-bust.js:124"
        },
        {
          "id": "horizonBustRefusalTree.told.l3",
          "who": "you",
          "text": "Can it put itself back?",
          "source": "src/game/horizon-bust.js:125"
        },
        {
          "id": "horizonBustRefusalTree.told.l4",
          "who": "bust",
          "text": "No. Turn round if you like. What's gone stays gone. I'm marble; I find this distressingly casual.",
          "source": "src/game/horizon-bust.js:126"
        },
        {
          "id": "horizonBustRefusalTree.told.l5",
          "who": "bust",
          "text": "The ground stays under your feet. Stop to listen, look about — you're allowed. Walk beside the picture if you like; it won't take away the road you've walked. No need to walk it twice on my account.",
          "source": "src/game/horizon-bust.js:127"
        },
        {
          "id": "horizonBustRefusalTree.told.l6",
          "who": "you",
          "text": "And the end?",
          "source": "src/game/horizon-bust.js:128"
        },
        {
          "id": "horizonBustRefusalTree.told.l7",
          "who": "bust",
          "text": "The chapel is ahead. Keep going when you're ready; it doesn't require my eyes or my permission. The nave is a different problem, of course. I remain available for complaints.",
          "source": "src/game/horizon-bust.js:129"
        }
      ],
      "source": "src/game/horizon-bust.js:122"
    },
    "horizonBustRefusalTree.stone": {
      "id": "horizonBustRefusalTree.stone",
      "type": "line",
      "lines": [
        {
          "id": "horizonBustRefusalTree.stone.l0",
          "who": "direction",
          "text": "The bust returns to stone with a dazzling immediacy. Even immobile objects know how to end conversations faster than you.",
          "source": "src/game/horizon-bust.js:136"
        }
      ],
      "source": "src/game/horizon-bust.js:136"
    },
    "horizonBustProposition.start": {
      "id": "horizonBustProposition.start",
      "type": "line",
      "lines": [
        {
          "id": "horizonBustProposition.start.l0",
          "who": "direction",
          "text": "The hand-shaped hollow is warm. Your own hand did that, and not long ago.",
          "source": "src/game/horizon-bust.js:162"
        },
        {
          "id": "horizonBustProposition.start.l1",
          "who": "bust",
          "text": "The same phase. I will give you your breath and enough battery to answer. The damage stays. Two returns, then the full peal.",
          "source": "src/game/horizon-bust.js:163"
        },
        {
          "id": "horizonBustProposition.start.l2",
          "who": "bust",
          "text": "There you are. I did say.",
          "source": "src/game/horizon-bust.js:165"
        },
        {
          "id": "horizonBustProposition.start.l3",
          "who": "bust",
          "text": "Again. I am starting to feel responsible for you, which is new, and I do not care for it.",
          "source": "src/game/horizon-bust.js:166"
        },
        {
          "id": "horizonBustProposition.start.l4",
          "who": "direction",
          "text": "An open hand is cut low in the stone. Its dark palm and fingertips have been worn smooth.",
          "source": "src/game/horizon-bust.js:169"
        },
        {
          "id": "horizonBustProposition.start.l5",
          "who": "bust",
          "text": "There. That is the other way.",
          "source": "src/game/horizon-bust.js:170"
        }
      ],
      "source": "src/game/horizon-bust.js:162"
    },
    "horizonBustProposition.questions": {
      "id": "horizonBustProposition.questions",
      "type": "choice",
      "lines": [],
      "choices": [
        {
          "id": "horizonBustProposition.questions.c0",
          "text": "What are the Second Minutes?",
          "source": "src/game/horizon-bust.js:179",
          "goto": "horizonBustProposition.history"
        },
        {
          "id": "horizonBustProposition.questions.c1",
          "text": "Where does this go?",
          "source": "src/game/horizon-bust.js:180",
          "goto": "horizonBustProposition.route"
        },
        {
          "id": "horizonBustProposition.questions.c2",
          "text": "What's the catch?",
          "source": "src/game/horizon-bust.js:181",
          "goto": "horizonBustProposition.consequence"
        },
        {
          "id": "horizonBustProposition.questions.c3",
          "text": "Enough. Show me the choice.",
          "source": "src/game/horizon-bust.js:182",
          "goto": "horizonBustProposition.decision"
        }
      ],
      "source": "src/game/horizon-bust.js:179"
    },
    "horizonBustProposition.identity": {
      "id": "horizonBustProposition.identity",
      "type": "line",
      "lines": [
        {
          "id": "horizonBustProposition.identity.l0",
          "who": "bust",
          "text": "A bust. These days.",
          "source": "src/game/horizon-bust.js:189"
        },
        {
          "id": "horizonBustProposition.identity.l1",
          "who": "you",
          "text": "Of who?",
          "source": "src/game/horizon-bust.js:190"
        },
        {
          "id": "horizonBustProposition.identity.l2",
          "who": "bust",
          "text": "Does a bust know who they're made in image of? At least I don't. Who knows. I've gone through many names in my eternal boredom, Maximilian de la Visconty de Routledge, Saint-Fernandique-du-Tabernaque, Jacobo 'Ojos Piedras' Baxoreicoacha, maybe my true identity lies somewhere in between the many names I've given myself.",
          "source": "src/game/horizon-bust.js:191"
        }
      ],
      "source": "src/game/horizon-bust.js:189"
    },
    "horizonBustProposition.history": {
      "id": "horizonBustProposition.history",
      "type": "line",
      "lines": [
        {
          "id": "horizonBustProposition.history.l0",
          "who": "you",
          "text": "What are the Second Minutes?",
          "source": "src/game/horizon-bust.js:198"
        },
        {
          "id": "horizonBustProposition.history.l1",
          "who": "bust",
          "text": "The minutes after the meeting ended. The things nobody wanted in the first set.",
          "source": "src/game/horizon-bust.js:199"
        },
        {
          "id": "horizonBustProposition.history.l2",
          "who": "you",
          "text": "That's an organization?",
          "source": "src/game/horizon-bust.js:200"
        },
        {
          "id": "horizonBustProposition.history.l3",
          "who": "bust",
          "text": "Eventually.",
          "source": "src/game/horizon-bust.js:201"
        }
      ],
      "source": "src/game/horizon-bust.js:198"
    },
    "horizonBustProposition.route": {
      "id": "horizonBustProposition.route",
      "type": "line",
      "lines": [
        {
          "id": "horizonBustProposition.route.l0",
          "who": "you",
          "text": "Where does this go?",
          "source": "src/game/horizon-bust.js:208"
        },
        {
          "id": "horizonBustProposition.route.l1",
          "who": "bust",
          "text": "A detour. Some would call it a French exit. A path beside this pedestal, out of the side of the picture. Bells beyond it; the tower at the far end.",
          "source": "src/game/horizon-bust.js:209"
        },
        {
          "id": "horizonBustProposition.route.l2",
          "who": "you",
          "text": "Do the bells ring?",
          "source": "src/game/horizon-bust.js:210"
        },
        {
          "id": "horizonBustProposition.route.l3",
          "who": "bust",
          "text": "Most have the good manners not to. A few don't. Make enough noise and you'll have to walk that part again. I recommend a quiet entrance.",
          "source": "src/game/horizon-bust.js:211"
        },
        {
          "id": "horizonBustProposition.route.l4",
          "who": "you",
          "text": "How much longer?",
          "source": "src/game/horizon-bust.js:212"
        },
        {
          "id": "horizonBustProposition.route.l5",
          "who": "bust",
          "text": "How should I know? I'm marble and metal. There is time to look around. The bells do not object to patience.",
          "source": "src/game/horizon-bust.js:213"
        }
      ],
      "source": "src/game/horizon-bust.js:208"
    },
    "horizonBustProposition.consequence": {
      "id": "horizonBustProposition.consequence",
      "type": "line",
      "lines": [
        {
          "id": "horizonBustProposition.consequence.l0",
          "who": "you",
          "text": "What's the catch?",
          "source": "src/game/horizon-bust.js:220"
        },
        {
          "id": "horizonBustProposition.consequence.l1",
          "who": "bust",
          "text": "Once I open it, you're committed to the tower. No going back to the thing by the lift. No taking the nave instead.",
          "source": "src/game/horizon-bust.js:221"
        },
        {
          "id": "horizonBustProposition.consequence.l2",
          "who": "you",
          "text": "And the tower?",
          "source": "src/game/horizon-bust.js:222"
        },
        {
          "id": "horizonBustProposition.consequence.l3",
          "who": "bust",
          "text": "It's easier as long as you don't lose.",
          "source": "src/game/horizon-bust.js:223"
        },
        {
          "id": "horizonBustProposition.consequence.l4",
          "who": "you",
          "text": "And if I lose?",
          "source": "src/game/horizon-bust.js:224"
        },
        {
          "id": "horizonBustProposition.consequence.l5",
          "who": "bust",
          "text": "Then I'll see you here again, but you'll have no choice but to continue.",
          "source": "src/game/horizon-bust.js:225"
        },
        {
          "id": "horizonBustProposition.consequence.l6",
          "who": "bust",
          "text": "The first two defeats bring you back to me. The third is final. There is no fourth attempt.",
          "source": "src/game/horizon-bust.js:226"
        }
      ],
      "source": "src/game/horizon-bust.js:220"
    },
    "horizonBustProposition.decision": {
      "id": "horizonBustProposition.decision",
      "type": "line",
      "lines": [
        {
          "id": "horizonBustProposition.decision.l0",
          "who": "you",
          "text": "Can I go back? Take the other way?",
          "source": "src/game/horizon-bust.js:233"
        },
        {
          "id": "horizonBustProposition.decision.l1",
          "who": "bust",
          "text": "No. I told you that part before you agreed, which is more than most get.",
          "source": "src/game/horizon-bust.js:235"
        },
        {
          "id": "horizonBustProposition.decision.l2",
          "who": "bust",
          "text": "You know the answer. Ask me something you do not know.",
          "source": "src/game/horizon-bust.js:236"
        },
        {
          "id": "horizonBustProposition.decision.l3",
          "who": "direction",
          "text": "There is one hand-shaped hollow, and it is the one your hand already knows.",
          "source": "src/game/horizon-bust.js:237"
        },
        {
          "id": "horizonBustProposition.decision.l4",
          "who": "bust",
          "text": "Two attempts remain. The third defeat is final. / This is your last attempt. A third defeat is final.",
          "source": "src/game/horizon-bust.js:238"
        },
        {
          "id": "horizonBustProposition.decision.l5",
          "who": "bust",
          "text": "So. Keep going to the chapel, or take my path. Agree, and it is the tower: no going back to the lift, no choosing the nave later.",
          "source": "src/game/horizon-bust.js:240"
        },
        {
          "id": "horizonBustProposition.decision.l6",
          "who": "bust",
          "text": "The first two defeats bring you back to me. The third is final. There is no fourth attempt. Put your hand in the worn seal only if you accept that.",
          "source": "src/game/horizon-bust.js:241"
        }
      ],
      "source": "src/game/horizon-bust.js:233"
    },
    "horizonBustProposition.accepted": {
      "id": "horizonBustProposition.accepted",
      "type": "line",
      "lines": [
        {
          "id": "horizonBustProposition.accepted.l0",
          "who": "direction",
          "text": "The path is still there, leading away from the picture. It never closed.",
          "source": "src/game/horizon-bust.js:255"
        },
        {
          "id": "horizonBustProposition.accepted.l1",
          "who": "bust",
          "text": "They still know you are coming. That was never the hard part.",
          "source": "src/game/horizon-bust.js:257"
        },
        {
          "id": "horizonBustProposition.accepted.l2",
          "who": "bust",
          "text": "Last time I will watch you do this. One way or the other.",
          "source": "src/game/horizon-bust.js:258"
        },
        {
          "id": "horizonBustProposition.accepted.l3",
          "who": "you",
          "text": "All that, and it is a button?",
          "source": "src/game/horizon-bust.js:260"
        },
        {
          "id": "horizonBustProposition.accepted.l4",
          "who": "bust",
          "text": "You've already agreed. The button is ceremonial. Call it user experience.",
          "source": "src/game/horizon-bust.js:261"
        },
        {
          "id": "horizonBustProposition.accepted.l5",
          "who": "direction",
          "text": "The dark inlay warms under your palm. A narrow path opens beside the pedestal and bends out of the picture. Bells hang beyond it.",
          "source": "src/game/horizon-bust.js:262"
        },
        {
          "id": "horizonBustProposition.accepted.l6",
          "who": "bust",
          "text": "There. Walk it. Most of the bells are silent; not all. Make enough noise and you'll have to walk that bit again, from the last quiet clearing. Reach the next clearing and the noise settles. They know you're coming. No need to announce yourself.",
          "source": "src/game/horizon-bust.js:263"
        },
        {
          "id": "horizonBustProposition.accepted.l7",
          "who": "you",
          "text": "Fun.",
          "source": "src/game/horizon-bust.js:264"
        }
      ],
      "source": "src/game/horizon-bust.js:255"
    },
    "horizonBustProposition.declined": {
      "id": "horizonBustProposition.declined",
      "type": "line",
      "lines": [
        {
          "id": "horizonBustProposition.declined.l0",
          "who": "you",
          "text": "I'm alright for now.",
          "source": "src/game/horizon-bust.js:271"
        },
        {
          "id": "horizonBustProposition.declined.l1",
          "who": "bust",
          "text": "Don't say I didn't warn you.",
          "source": "src/game/horizon-bust.js:272"
        },
        {
          "id": "horizonBustProposition.declined.l2",
          "who": "direction",
          "text": "Your hand stays off the seal. Beyond the pedestal, the chapel light holds.",
          "source": "src/game/horizon-bust.js:273"
        }
      ],
      "source": "src/game/horizon-bust.js:271"
    }
  }
}
