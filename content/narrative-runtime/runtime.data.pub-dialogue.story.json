      "source": "src/data/pub-dialogue.js:36"
    },
    "buildPubBartenderDialogue.tree.offer": {
      "id": "buildPubBartenderDialogue.tree.offer",
      "type": "choice",
      "lines": [
        {
          "id": "buildPubBartenderDialogue.tree.offer.l0",
          "who": "unknown",
          "text": "There are two waters on the tray, this side of the counter. Mavis and Ed are at the table nearest the entrance: she has the bus badge, he has the work jacket.",
          "source": "src/data/pub-dialogue.js:38"
        },
        {
          "id": "buildPubBartenderDialogue.tree.offer.l1",
          "who": "unknown",
          "text": "Then could you clear the empty glasses from the next table along? Bert and Farah, with the dominoes. Bring the tray back to me when you have done.",
          "source": "src/data/pub-dialogue.js:39"
        },
        {
          "id": "buildPubBartenderDialogue.tree.offer.l2",
          "who": "unknown",
          "text": "I am all right here. I just cannot get out from behind the bar.",
          "source": "src/data/pub-dialogue.js:40"
        }
      ],
      "choices": [
        {
          "id": "buildPubBartenderDialogue.tree.offer.c0",
          "text": "Of course. I can do a turn round the tables.",
          "source": "src/data/pub-dialogue.js:41",
          "choiceId": "pub-iona.accept",
          "goto": "buildPubBartenderDialogue.tree.accepted"
        },
        {
          "id": "buildPubBartenderDialogue.tree.offer.c1",
          "text": "I cannot stop to help tonight.",
          "source": "src/data/pub-dialogue.js:41",
          "choiceId": "pub-iona.decline",
          "goto": "buildPubBartenderDialogue.tree.declined"
        },
        {
          "id": "buildPubBartenderDialogue.tree.offer.c2",
          "text": "Leave it for now.",
          "source": "src/data/pub-dialogue.js:41",
          "choiceId": "pub-iona.no-promise",
          "targetName": "done"
        }
      ],
      "source": "src/data/pub-dialogue.js:38"
    },
    "buildPubBartenderDialogue.tree.accepted": {
      "id": "buildPubBartenderDialogue.tree.accepted",
      "type": "choice",
      "lines": [
        {
          "id": "buildPubBartenderDialogue.tree.accepted.l0",
          "who": "unknown",
          "text": "Thank you. The tray is ready. Do not let Bert talk you into judging the game; you will be there all night.",
          "source": "src/data/pub-dialogue.js:42"
        }
      ],
      "choices": [
        {
          "id": "buildPubBartenderDialogue.tree.accepted.c0",
          "text": "Leave Iona to the bar.",
          "source": "src/data/pub-dialogue.js:42",
          "choiceId": "pub-iona.leave",
          "targetName": "done"
        }
      ],
      "source": "src/data/pub-dialogue.js:42"
    },
    "buildPubBartenderDialogue.tree.declined": {
      "id": "buildPubBartenderDialogue.tree.declined",
      "type": "choice",
      "lines": [
        {
          "id": "buildPubBartenderDialogue.tree.declined.l0",
          "who": "unknown",
          "text": "All right. Thank you for saying. I will get round in a minute.",
          "source": "src/data/pub-dialogue.js:43"
        }
      ],
      "choices": [
        {
          "id": "buildPubBartenderDialogue.tree.declined.c0",
          "text": "Leave Iona to the bar.",
          "source": "src/data/pub-dialogue.js:43",
          "choiceId": "pub-iona.leave",
          "targetName": "done"
        }
      ],
      "source": "src/data/pub-dialogue.js:43"
    },
    "buildPubBartenderDialogue.tree.reminder": {
      "id": "buildPubBartenderDialogue.tree.reminder",
      "type": "choice",
      "lines": [
        {
          "id": "buildPubBartenderDialogue.tree.reminder.l0",
          "who": "unknown",
          "text": "Just the tray back to me, with those empties. Thank you.",
          "source": "src/data/pub-dialogue.js:44"
        },
        {
          "id": "buildPubBartenderDialogue.tree.reminder.l1",
          "who": "unknown",
          "text": "The empty glasses at the next table: Bert and Farah, playing dominoes. Then bring the tray back here.",
          "source": "src/data/pub-dialogue.js:45"
        },
        {
          "id": "buildPubBartenderDialogue.tree.reminder.l2",
          "who": "unknown",
          "text": "Two waters to Mavis and Ed at the table nearest the entrance. Then clear the glasses from the domino table.",
          "source": "src/data/pub-dialogue.js:46"
        },
        {
          "id": "buildPubBartenderDialogue.tree.reminder.l3",
          "who": "unknown",
          "text": "The tray is this side of the counter. Waters to Mavis and Ed by the entrance, empties from Bert and Farah at the next table. Then back here.",
          "source": "src/data/pub-dialogue.js:47"
        }
      ],
      "choices": [
        {
          "id": "buildPubBartenderDialogue.tree.reminder.c0",
          "text": "Ask about something else.",
          "source": "src/data/pub-dialogue.js:47",
          "choiceId": "pub-iona.back",
          "goto": "buildPubBartenderDialogue.tree.start"
        },
        {
          "id": "buildPubBartenderDialogue.tree.reminder.c1",
          "text": "Leave Iona to the bar.",
          "source": "src/data/pub-dialogue.js:47",
          "choiceId": "pub-iona.leave",
          "targetName": "done"
        }
      ],
      "source": "src/data/pub-dialogue.js:44"
    },
    "buildPubBartenderDialogue.tree.thanks": {
      "id": "buildPubBartenderDialogue.tree.thanks",
      "type": "choice",
      "lines": [
        {
          "id": "buildPubBartenderDialogue.tree.thanks.l0",
          "who": "direction",
          "text": "You set the tray down. Iona takes the glasses by their bases and makes room for them under the counter.",
          "source": "src/data/pub-dialogue.js:49"
        },
        {
          "id": "buildPubBartenderDialogue.tree.thanks.l1",
          "who": "unknown",
          "text": "Thank you. It was getting away from me a bit there.",
          "source": "src/data/pub-dialogue.js:50"
        },
        {
          "id": "buildPubBartenderDialogue.tree.thanks.l2",
          "who": "direction",
          "text": "From the snug comes the small clack of a domino finally being played.",
          "source": "src/data/pub-dialogue.js:51"
        },
        {
          "id": "buildPubBartenderDialogue.tree.thanks.l3",
          "who": "unknown",
          "text": "There. You have even moved Bert along.",
          "source": "src/data/pub-dialogue.js:52"
        }
      ],
      "choices": [
        {
          "id": "buildPubBartenderDialogue.tree.thanks.c0",
          "text": "Let her get on with the bar.",
          "source": "src/data/pub-dialogue.js:53",
          "choiceId": "pub-iona.thanks-leave",
          "targetName": "done"
        }
      ],
      "source": "src/data/pub-dialogue.js:49"
    },
    "buildPubBartenderDialogue.tree.regulars": {
      "id": "buildPubBartenderDialogue.tree.regulars",
      "type": "choice",
      "lines": [
        {
          "id": "buildPubBartenderDialogue.tree.regulars.l0",
          "who": "unknown",
          "text": "People who meant to stay for one. The delivery driver has finished his break twice, by my reckoning.",
          "source": "src/data/pub-dialogue.js:55"
        },
        {
          "id": "buildPubBartenderDialogue.tree.regulars.l1",
          "who": "unknown",
          "text": "Some came over from the vigil when the cups ran out. I said they could carry on sitting quietly somewhere dry.",
          "source": "src/data/pub-dialogue.js:56"
        },
        {
          "id": "buildPubBartenderDialogue.tree.regulars.l2",
          "who": "unknown",
          "text": "We have spent twenty minutes deciding whose turn it is to wash up. The quiet has suffered.",
          "source": "src/data/pub-dialogue.js:57"
        },
        {
          "id": "buildPubBartenderDialogue.tree.regulars.l3",
          "who": "unknown",
          "text": "There is a tab on the slate for somebody in your line of work. Same signature as yours, near enough. I stopped asking.",
          "source": "src/data/pub-dialogue.js:58"
        }
      ],
      "choices": [
        {
          "id": "buildPubBartenderDialogue.tree.regulars.c0",
          "text": "Ask what they are keeping vigil for.",
          "source": "src/data/pub-dialogue.js:59",
          "choiceId": "pub-iona.vigil",
          "goto": "buildPubBartenderDialogue.tree.vigil"
        },
        {
          "id": "buildPubBartenderDialogue.tree.regulars.c1",
          "text": "Ask about something else.",
          "source": "src/data/pub-dialogue.js:59",
          "choiceId": "pub-iona.back",
          "goto": "buildPubBartenderDialogue.tree.start"
        },
        {
          "id": "buildPubBartenderDialogue.tree.regulars.c2",
          "text": "Leave Iona to the bar.",
          "source": "src/data/pub-dialogue.js:59",
          "choiceId": "pub-iona.leave",
          "targetName": "done"
        }
      ],
      "source": "src/data/pub-dialogue.js:55"
    },
    "buildPubBartenderDialogue.tree.vigil": {
      "id": "buildPubBartenderDialogue.tree.vigil",
      "type": "choice",
      "lines": [
        {
          "id": "buildPubBartenderDialogue.tree.vigil.l0",
          "who": "unknown",
          "text": "The school, mostly. People who studied there, people who cleaned it, people who used the baths before it was all one address.",
          "source": "src/data/pub-dialogue.js:61"
        },
        {
          "id": "buildPubBartenderDialogue.tree.vigil.l1",
          "who": "unknown",
          "text": "They do not agree on what ought to happen. They agreed to be there when it did.",
          "source": "src/data/pub-dialogue.js:62"
        },
        {
          "id": "buildPubBartenderDialogue.tree.vigil.l2",
          "who": "unknown",
          "text": "I sent tea. I can commit to tea without signing anybody’s petition.",
          "source": "src/data/pub-dialogue.js:63"
        }
      ],
      "choices": [
        {
          "id": "buildPubBartenderDialogue.tree.vigil.c0",
          "text": "Ask about something else.",
          "source": "src/data/pub-dialogue.js:64",
          "choiceId": "pub-iona.back",
          "goto": "buildPubBartenderDialogue.tree.start"
        },
        {
          "id": "buildPubBartenderDialogue.tree.vigil.c1",
          "text": "Leave Iona to the bar.",
          "source": "src/data/pub-dialogue.js:64",
          "choiceId": "pub-iona.leave",
          "targetName": "done"
        }
      ],
      "source": "src/data/pub-dialogue.js:61"
    },
    "buildPubBartenderDialogue.tree.ellery": {
      "id": "buildPubBartenderDialogue.tree.ellery",
      "type": "choice",
      "lines": [
        {
          "id": "buildPubBartenderDialogue.tree.ellery.l0",
          "who": "unknown",
          "text": "When the baths were open, we could set the kitchen clock by the last swimming session. Wet hair, chips, an argument about whose towel was whose.",
          "source": "src/data/pub-dialogue.js:66"
        },
        {
          "id": "buildPubBartenderDialogue.tree.ellery.l1",
          "who": "unknown",
          "text": "Then it was students counting coins out for one drink between them. Then staff asking if I had seen somebody who had already gone home.",
          "source": "src/data/pub-dialogue.js:67"
        },
        {
          "id": "buildPubBartenderDialogue.tree.ellery.l2",
          "who": "unknown",
          "text": "Now everyone asks what I hear at night. I hear a building nobody is paying to mend. That is frightening enough to begin with.",
          "source": "src/data/pub-dialogue.js:68"
        }
      ],
      "choices": [
        {
          "id": "buildPubBartenderDialogue.tree.ellery.c0",
          "text": "Ask whether she has heard anything else.",
          "source": "src/data/pub-dialogue.js:69",
          "choiceId": "pub-iona.noise",
          "goto": "buildPubBartenderDialogue.tree.noise"
        },
        {
          "id": "buildPubBartenderDialogue.tree.ellery.c1",
          "text": "Ask about something else.",
          "source": "src/data/pub-dialogue.js:69",
          "choiceId": "pub-iona.back",
          "goto": "buildPubBartenderDialogue.tree.start"
        },
        {
          "id": "buildPubBartenderDialogue.tree.ellery.c2",
          "text": "Leave Iona to the bar.",
          "source": "src/data/pub-dialogue.js:69",
          "choiceId": "pub-iona.leave",
          "targetName": "done"
        }
      ],
      "source": "src/data/pub-dialogue.js:66"
    },
    "buildPubBartenderDialogue.tree.noise": {
      "id": "buildPubBartenderDialogue.tree.noise",
      "type": "choice",
      "lines": [
        {
          "id": "buildPubBartenderDialogue.tree.noise.l0",
          "who": "unknown",
          "text": "Sometimes the cellar pipes carry a piano note. Always the same one. The plumber says pipes do that.",
          "source": "src/data/pub-dialogue.js:71"
        },
        {
          "id": "buildPubBartenderDialogue.tree.noise.l1",
          "who": "unknown",
          "text": "He came in on Thursday and asked if it had changed. I said no. He looked relieved, which was a new answer.",
          "source": "src/data/pub-dialogue.js:72"
        },
        {
          "id": "buildPubBartenderDialogue.tree.noise.l2",
          "who": "unknown",
          "text": "If you find an ordinary explanation, bring it over. I would like one I can repeat.",
          "source": "src/data/pub-dialogue.js:73"
        }
      ],
      "choices": [
        {
          "id": "buildPubBartenderDialogue.tree.noise.c0",
          "text": "Ask about something else.",
          "source": "src/data/pub-dialogue.js:74",
          "choiceId": "pub-iona.back",
          "goto": "buildPubBartenderDialogue.tree.start"
        },
        {
          "id": "buildPubBartenderDialogue.tree.noise.c1",
          "text": "Leave Iona to the bar.",
          "source": "src/data/pub-dialogue.js:74",
          "choiceId": "pub-iona.leave",
          "targetName": "done"
        }
      ],
      "source": "src/data/pub-dialogue.js:71"
    },
    "buildPubBartenderDialogue.tree.name": {
      "id": "buildPubBartenderDialogue.tree.name",
      "type": "choice",
      "lines": [
        {
          "id": "buildPubBartenderDialogue.tree.name.l0",
          "who": "unknown",
          "text": "It was The Lyric before the school bought half the street. People assume they named us; they assume a lot of things were theirs.",
          "source": "src/data/pub-dialogue.js:76"
        },
        {
          "id": "buildPubBartenderDialogue.tree.name.l1",
          "who": "unknown",
          "text": "My father had a piano in the snug. He could play three songs and would take requests for any of them.",
          "source": "src/data/pub-dialogue.js:77"
        },
        {
          "id": "buildPubBartenderDialogue.tree.name.l2",
          "who": "unknown",
          "text": "The name outlasted the piano. Pubs are very good at keeping the part you cannot sit on.",
          "source": "src/data/pub-dialogue.js:78"
        }
      ],
      "choices": [
        {
          "id": "buildPubBartenderDialogue.tree.name.c0",
          "text": "Ask about something else.",
          "source": "src/data/pub-dialogue.js:79",
          "choiceId": "pub-iona.back",
          "goto": "buildPubBartenderDialogue.tree.start"
        },
        {
          "id": "buildPubBartenderDialogue.tree.name.c1",
          "text": "Leave Iona to the bar.",
          "source": "src/data/pub-dialogue.js:79",
          "choiceId": "pub-iona.leave",
          "targetName": "done"
        }
      ],
      "source": "src/data/pub-dialogue.js:76"
    },
    "buildPubBartenderDialogue.strikeBack": {
      "id": "buildPubBartenderDialogue.strikeBack",
      "type": "choice",
      "lines": [],
      "choices": [
        {
          "id": "buildPubBartenderDialogue.strikeBack.c0",
          "text": "The students.",
          "source": "src/data/pub-dialogue.js:113",
          "choiceId": "pub-iona.strike-back",
          "targetName": "strike-questions"
        }
      ],
      "source": "src/data/pub-dialogue.js:113"
    },
    "buildPubBartenderDialogue.topic": {
      "id": "buildPubBartenderDialogue.topic",
      "type": "choice",
      "lines": [],
      "choices": [
        {
          "id": "buildPubBartenderDialogue.topic.c0",
          "text": "The students’ refusal.",
          "source": "src/data/pub-dialogue.js:114",
          "choiceId": "pub-iona.strike-topic",
          "targetName": "strike"
        }
      ],
      "source": "src/data/pub-dialogue.js:114"
    },
    "buildPubTrayDialogue.start": {
      "id": "buildPubTrayDialogue.start",
      "type": "choice",
      "lines": [
        {
          "id": "buildPubTrayDialogue.start.l0",
          "who": "direction",
          "text": "The tray is back with Iona. She has the next glasses under way. / You already have Iona’s tray. / A tray with two waters waits on the public side of the bar. Iona is trying to find a moment to carry it over.",
          "source": "src/data/pub-dialogue.js:167"
        },
        {
          "id": "buildPubTrayDialogue.start.l1",
          "who": "direction",
          "text": "Two waters on a wooden tray. A folded cloth keeps the glasses from sliding.",
          "source": "src/data/pub-dialogue.js:169"
        },
        {
          "id": "buildPubTrayDialogue.start.l2",
          "who": "direction",
          "text": "Mavis and Ed are at the table nearest the entrance. The empty glasses are at the domino table beside them.",
          "source": "src/data/pub-dialogue.js:169"
        }
      ],
      "choices": [
        {
          "id": "buildPubTrayDialogue.start.c0",
          "text": "Take the tray over to the tables.",
          "source": "src/data/pub-dialogue.js:169",
          "choiceId": "pub-iona.take-tray",
          "goto": "buildPubTrayDialogue.taken"
        },
        {
          "id": "buildPubTrayDialogue.start.c1",
          "text": "Leave the tray for the moment.",
          "source": "src/data/pub-dialogue.js:169",
          "choiceId": "pub-iona.leave-tray",
          "targetName": "done"
        }
      ],
      "source": "src/data/pub-dialogue.js:167"
    },
    "buildPubTrayDialogue.taken": {
      "id": "buildPubTrayDialogue.taken",
      "type": "line",
      "lines": [
        {
          "id": "buildPubTrayDialogue.taken.l0",
          "who": "direction",
          "text": "You lift the tray level. The water shifts once and settles.",
          "source": "src/data/pub-dialogue.js:170"
        }
      ],
      "source": "src/data/pub-dialogue.js:170"
    },
    "buildPubServiceDialogue.start": {
      "id": "buildPubServiceDialogue.start",
      "type": "choice",
      "lines": [
        {
          "id": "buildPubServiceDialogue.start.l0",
          "who": "direction",
          "text": "Mavis draws her coat in from the table edge. Ed shifts his chair so you can reach. / Farah moves the empty glasses clear of the dominoes. Bert checks one for a last mouthful before letting it go.",
          "source": "src/data/pub-dialogue.js:189"
        }
      ],
      "choices": [
        {
          "id": "buildPubServiceDialogue.start.c0",
          "text": "Leave them to their evening.",
          "source": "src/data/pub-dialogue.js:189",
          "choiceId": "pub-iona.service-leave",
          "targetName": "done"
        }
      ],
      "source": "src/data/pub-dialogue.js:189"
    },
    "buildPubServiceDialogue.pub-service-thanks": {
      "id": "buildPubServiceDialogue.pub-service-thanks",
      "type": "line",
      "lines": [
        {
          "id": "buildPubServiceDialogue.pub-service-thanks.l0",
          "who": "direction",
          "text": "You put the waters down. Mavis lifts hers in thanks; Ed gives you a quiet nod. The tray is empty.",
          "source": "src/data/pub-dialogue.js:190"
        },
        {
          "id": "buildPubServiceDialogue.pub-service-thanks.l1",
          "who": "direction",
          "text": "You gather the glasses onto the tray. Farah catches a rolling domino before it can join them.",
          "source": "src/data/pub-dialogue.js:191"
        },
        {
          "id": "buildPubServiceDialogue.pub-service-thanks.l2",
          "who": "direction",
          "text": "Iona is waiting behind the bar. There is a clear space on the counter for the tray.",
          "source": "src/data/pub-dialogue.js:191"
        }
      ],
      "source": "src/data/pub-dialogue.js:190"
    },
    "buildPubFavorDialogue.start": {
      "id": "buildPubFavorDialogue.start",
      "type": "choice",
      "lines": [
        {
          "id": "buildPubFavorDialogue.start.l0",
          "who": "direction",
          "text": "Iona has this back at The Lyric. / You are already carrying this back to Iona. / {description} It belongs to the pub; ask Iona before taking it away.",
          "source": "src/data/pub-dialogue.js:199"
        },
        {
          "id": "buildPubFavorDialogue.start.l1",
          "who": "direction",
          "text": "This is the thing Iona asked you to bring back.",
          "source": "src/data/pub-dialogue.js:201"
        }
      ],
      "choices": [
        {
          "id": "buildPubFavorDialogue.start.c0",
          "text": "Take the bottle opener / the order book back to Iona.",
          "source": "src/data/pub-dialogue.js:201",
          "choiceId": "pub-iona.take-{spec.id}",
          "goto": "buildPubFavorDialogue.taken"
        },
        {
          "id": "buildPubFavorDialogue.start.c1",
          "text": "Leave it here for the moment.",
          "source": "src/data/pub-dialogue.js:201",
          "choiceId": "pub-iona.{spec.id}-leave-item",
          "targetName": "done"
        }
      ],
      "source": "src/data/pub-dialogue.js:199"
    },
    "buildPubFavorDialogue.taken": {
      "id": "buildPubFavorDialogue.taken",
      "type": "line",
      "lines": [
        {
          "id": "buildPubFavorDialogue.taken.l0",
          "who": "direction",
          "text": "You put the opener in the bag, where its edge will not catch the cloth. / You close the book and put it in the bag, away from the wet case lining.",
          "source": "src/data/pub-dialogue.js:202"
        }
      ],
      "source": "src/data/pub-dialogue.js:202"
    }
  }
}
