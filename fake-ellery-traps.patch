+    for(const[dx,dz]of directions){
+      const ix=node.ix+dx,iz=node.iz+dz,x=origin.x+ix*step,z=origin.z+iz*step;
+      if(x<bounds.minX||x>bounds.maxX||z<bounds.minZ||z>bounds.maxZ)continue;
