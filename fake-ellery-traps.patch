+test('walls, closed leaves and insufficient HUSH headroom cannot create a camera-front or unsupported substitute',()=>{
+  const door={id:'rear-seal',x:0,z:1,feet:4.8,normal:{x:0,z:1},halfWidth:20,openInitial:false};
