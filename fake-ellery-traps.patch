+  const before=copy(state),m=openingCabInspectionModel(state);assert.equal(m.workOrder,WORK_ORDER);assert.equal(m.accepted,false);assert.equal(m.destination,STORY_TARGET.van.label);
+  assert.deepEqual(m.facts.find(f=>f[0]==='COMPOSURE'),['COMPOSURE','6 / 10']);assert.deepEqual(m.facts.find(f=>f[0]==='FIELD CELL'),['FIELD CELL','40%']);
+  assert.ok(m.equipment.every(e=>e.facts.find(f=>f[0]==='POSITION')[1]==='BACK OF THE VAN'));
+  assert.match(m.equipment.find(e=>e.id==='headphones-closed').description,/15%/);assert.deepEqual(m.notes,[]);assert.equal('timeRemaining' in m,false);assert.deepEqual(state,before);
