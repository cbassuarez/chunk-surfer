+  assert.equal(claim(null, 'hand-2', [take(1)], { chapter: 'II', destination: { ...target, chapter: 'I' } }).handled, false);
+  assert.equal(claim(null, 'hand-2', [take(1)], { runId: '' }).handled, false);
+});
