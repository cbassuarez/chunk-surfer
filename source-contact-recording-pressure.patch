+  function snapshot(){return{...state};}
+  function update(dt=0,input={}){
+    // A resumed frame cannot spend wall-clock absence as an approach or release.
+    // Input suspension also covers slate, decoding and other presentation owners.
+    const disabled=input.effectsMode==='off'||input.enabled===false||input.tutorial||input.slating||input.lightOn;
