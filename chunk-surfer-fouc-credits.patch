@@ -0,0 +1,26 @@
+let readyMarked = false;
+
+function afterNextPaint(callback) {
+  const raf = globalThis.requestAnimationFrame || ((fn) => setTimeout(fn, 16));
+  raf(() => raf(callback));
+}
+
+export function markAppReady({ removeDelayMs = 260, document: doc = globalThis.document } = {}) {
+  if (readyMarked || !doc?.body) return false;
+  readyMarked = true;
+
+  afterNextPaint(() => {
+    doc.body.classList.remove('cs-preboot');
+    doc.body.classList.add('cs-ready');
+
+    globalThis.setTimeout?.(() => {
+      doc.querySelector?.('.boot-curtain')?.remove?.();
+    }, removeDelayMs);
+  });
+
+  return true;
+}
+
+export function resetAppReadyForTests() {
+  readyMarked = false;
+}
